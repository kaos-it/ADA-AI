/* =========================================================
   TEXTAREA
   ========================================================= */

function adjustTextareaHeight() {

    if (!textarea) return;


    textarea.style.height =
        'auto';


    textarea.style.height =
        Math.min(
            textarea.scrollHeight,
            140
        ) + 'px';

}


if (textarea) {

    textarea.addEventListener(
        'input',
        adjustTextareaHeight
    );

}


/* =========================================================
   CLEAN TEXT FOR SPEECH
   ========================================================= */

function getCleanSpeechText(
    html
) {

    const temp =
        document.createElement('div');


    temp.innerHTML =
        html || '';


    let text =
        temp.innerText ||
        temp.textContent ||
        '';


    /*
       Markdown-dan qalan lazımsız simvolları
       səs üçün təmizləyirik.
    */

    text = text
        .replace(/\*\*/g, '')
        .replace(/\*/g, '')
        .replace(/__/g, '')
        .replace(/_/g, '')
        .replace(/#{1,6}\s/g, '')
        .replace(/`/g, '')
        .replace(/•/g, '')
        .replace(/\[(.*?)\]\(.*?\)/g, '$1')
        .replace(/\s+/g, ' ')
        .trim();


    return text;

}


/* =========================================================
   LOAD SPEECH VOICES
   ========================================================= */

function loadSpeechVoices() {

    if (
        !('speechSynthesis' in window)
    ) {

        return;

    }


    speechVoices =
        window.speechSynthesis.getVoices();

}


loadSpeechVoices();


if (
    'speechSynthesis' in window
) {

    window.speechSynthesis.onvoiceschanged =
        () => {

            loadSpeechVoices();

        };

}


/* =========================================================
   FIND BEST VOICE
   ========================================================= */

function getBestVoice(
    language
) {

    const voices =
        window.speechSynthesis.getVoices();


    if (!voices.length) {

        return null;

    }


    const lang =
        (language || 'az-AZ')
            .toLowerCase();


    /*
       1. Tam uyğun dil
    */

    let voice =
        voices.find(v =>
            v.lang &&
            v.lang.toLowerCase() === lang
        );


    if (voice) {

        return voice;

    }


    /*
       2. Dil prefiksi
    */

    const prefix =
        lang.split('-')[0];


    voice =
        voices.find(v =>
            v.lang &&
            v.lang
                .toLowerCase()
                .startsWith(prefix)
        );


    if (voice) {

        return voice;

    }


    /*
       3. Azərbaycan dili üçün Türk dili
    */

    if (prefix === 'az') {

        voice =
            voices.find(v =>
                v.lang &&
                v.lang
                    .toLowerCase()
                    .startsWith('tr')
            );


        if (voice) {

            return voice;

        }

    }


    /*
       4. Azərbaycan dili üçün rus dili
       son alternativ
    */

    if (prefix === 'az') {

        voice =
            voices.find(v =>
                v.lang &&
                v.lang
                    .toLowerCase()
                    .startsWith('ru')
            );


        if (voice) {

            return voice;

        }

    }


    /*
       5. Heç nə tapılmasa default
    */

    return voices[0];

}


/* =========================================================
   DETECT LANGUAGE
   ========================================================= */

function detectLanguage(
    text
) {

    if (!text) {

        return 'az-AZ';

    }


    /*
       Rus dili
    */

    if (
        /[а-яА-ЯёЁ]/.test(text)
    ) {

        return 'ru-RU';

    }


    /*
       Ərəb dili
    */

    if (
        /[\u0600-\u06FF]/.test(text)
    ) {

        return 'ar-SA';

    }


    /*
       Azərbaycan dili
    */

    if (
        /[əıöüçşğƏİÖÜÇŞĞ]/.test(text)
    ) {

        return 'az-AZ';

    }


    /*
       Türk dilinə aid simvollar
    */

    if (
        /[çğıöşüÇĞİÖŞÜ]/.test(text)
    ) {

        return 'tr-TR';

    }


    /*
       Default
    */

    return 'en-US';

}


/* =========================================================
   RESET SPEECH BUTTON
   ========================================================= */

function resetSpeechButton(
    button
) {

    if (!button) return;


    button.classList.remove(
        'speaking'
    );


    const icon =
        button.querySelector('i');


    const span =
        button.querySelector('span');


    if (icon) {

        icon.className =
            'fa-solid fa-volume-high';

    }


    if (span) {

        span.textContent =
            'Səsləndir';

    }

}


/* =========================================================
   STOP CURRENT SPEECH
   ========================================================= */

function stopCurrentSpeech() {

    if (
        'speechSynthesis' in window
    ) {

        window.speechSynthesis.cancel();

    }


    if (activeSpeechButton) {

        resetSpeechButton(
            activeSpeechButton
        );

    }


    activeSpeechButton =
        null;

    activeUtterance =
        null;

}


/* =========================================================
   SPEAK AI TEXT
   ========================================================= */

function speakAIText(
    htmlText,
    button
) {

    if (
        !('speechSynthesis' in window)
    ) {

        alert(
            'Bu cihazda səsli oxuma funksiyası dəstəklənmir.'
        );

        return;

    }


    /*
       Eyni düyməyə yenidən basılıbsa
       səsi dayandır.
    */

    if (
        activeSpeechButton === button &&
        window.speechSynthesis.speaking
    ) {

        stopCurrentSpeech();

        return;

    }


    /*
       Əvvəlki səsi dayandır.
    */

    stopCurrentSpeech();


    const cleanText =
        getCleanSpeechText(
            htmlText
        );


    if (!cleanText) {

        return;

    }


    /*
       Mətndən dili avtomatik müəyyən et.
    */

    const detectedLang =
        detectLanguage(
            cleanText
        );


    /*
       Azərbaycan dili üçün istifadəçinin
       seçdiyi dili üstün tuturuq.
    */

    let speechLanguage =
        detectedLang;


    if (
        detectedLang === 'az-AZ'
    ) {

        speechLanguage =
            'az-AZ';

    }


    /*
       Səs seç.
    */

    const voice =
        getBestVoice(
            speechLanguage
        );


    const utterance =
        new SpeechSynthesisUtterance(
            cleanText
        );


    /*
       Səs parametrləri
    */

    utterance.lang =
        voice
            ? voice.lang
            : speechLanguage;


    if (voice) {

        utterance.voice =
            voice;

    }


    /*
       Telefon üçün daha təbii sürət.
    */

    utterance.rate =
        0.88;


    utterance.pitch =
        1.0;


    utterance.volume =
        1.0;


    /*
       Düymə vəziyyəti.
    */

    activeSpeechButton =
        button;

    activeUtterance =
        utterance;


    button.classList.add(
        'speaking'
    );


    const icon =
        button.querySelector('i');


    const span =
        button.querySelector('span');


    if (icon) {

        icon.className =
            'fa-solid fa-stop';

    }


    if (span) {

        span.textContent =
            'Dayandır';

    }


    /*
       Bitdikdə.
    */

    utterance.onend =
        () => {

            resetSpeechButton(
                button
            );

            activeSpeechButton =
                null;

            activeUtterance =
                null;

        };


    /*
       Xəta olduqda.
    */

    utterance.onerror =
        (error) => {

            console.error(
                'Səs oxuma xətası:',
                error
            );


            resetSpeechButton(
                button
            );


            activeSpeechButton =
                null;

            activeUtterance =
                null;

        };


    /*
       Bəzi Android Chrome cihazlarında
       speechSynthesis ilk çağırışda ilişə bilir.

       Ona görə resume + kiçik timeout.
    */

    try {

        window.speechSynthesis.resume();

    } catch (e) {}


    setTimeout(() => {

        try {

            window.speechSynthesis.speak(
                utterance
            );

        } catch (error) {

            console.error(
                'Səsləndirmə başlatma xətası:',
                error
            );

            resetSpeechButton(
                button
            );

        }

    }, 80);

}


/* =========================================================
   COPY TEXT
   ========================================================= */

async function copyAIText(
    htmlText,
    button
) {

    const cleanText =
        getCleanSpeechText(
            htmlText
        );


    if (!cleanText) {

        return;

    }


    try {

        if (
            navigator.clipboard &&
            window.isSecureContext
        ) {

            await navigator.clipboard.writeText(
                cleanText
            );

        } else {

            const textareaCopy =
                document.createElement(
                    'textarea'
                );


            textareaCopy.value =
                cleanText;


            textareaCopy.style.position =
                'fixed';

            textareaCopy.style.opacity =
                '0';

            textareaCopy.style.pointerEvents =
                'none';


            document.body.appendChild(
                textareaCopy
            );


            textareaCopy.focus();

            textareaCopy.select();


            document.execCommand(
                'copy'
            );


            textareaCopy.remove();

        }


        button.classList.add(
            'copied'
        );


        const icon =
            button.querySelector('i');


        const span =
            button.querySelector('span');


        if (icon) {

            icon.className =
                'fa-solid fa-check';

        }


        if (span) {

            span.textContent =
                'Kopyalandı';

        }


        setTimeout(() => {

            button.classList.remove(
                'copied'
            );


            if (icon) {

                icon.className =
                    'fa-regular fa-copy';

            }


            if (span) {

                span.textContent =
                    'Kopyala';

            }

        }, 1800);


    } catch (error) {

        console.error(
            'Kopyalama xətası:',
            error
        );


        alert(
            'Mətni kopyalamaq mümkün olmadı.'
        );

    }

}


/* =========================================================
   APPEND MESSAGE UI
   ========================================================= */

function appendMessageUI(
    text,
    sender,
    isHtml = false,
    fileBase64 = null
) {

    const messageDiv =
        document.createElement('div');


    messageDiv.classList.add(
        'message',
        sender
    );


    const avatarDiv =
        document.createElement('div');


    avatarDiv.classList.add(
        'avatar'
    );


    /*
       AI AVATAR
    */

    if (sender === 'ai') {

        avatarDiv.innerHTML =
            '<img src="/ada-logo.jpeg" alt="ADA AI">';

    } else {

        /*
           USER AVATAR
        */

        if (userPicture) {

            avatarDiv.innerHTML =
                `<img src="${userPicture}" alt="User">`;

        } else {

            avatarDiv.innerHTML =
                '<i class="fa-solid fa-user"></i>';

        }

    }


    const contentDiv =
        document.createElement('div');


    contentDiv.classList.add(
        'message-content'
    );


    /*
       ======================================================
       AI MESSAGE
       ======================================================
    */

    if (sender === 'ai') {

        /*
           Markdown → HTML
        */

        const parsedMarkdown =
            marked.parse(
                text || ''
            );


        /*
           XSS təhlükəsizliyi
        */

        const sanitizedHtml =
            DOMPurify.sanitize(
                parsedMarkdown,
                {
                    ADD_ATTR: ['target']
                }
            );


        contentDiv.innerHTML =
            sanitizedHtml;


        /*
           AI BUTTONS
        */

        const actionsDiv =
            document.createElement(
                'div'
            );


        actionsDiv.classList.add(
            'ai-message-actions'
        );


        /*
           SPEAK BUTTON
        */

        const speakBtn =
            document.createElement(
                'button'
            );


        speakBtn.type =
            'button';


        speakBtn.classList.add(
            'ai-message-action'
        );


        speakBtn.innerHTML = `
            <i class="fa-solid fa-volume-high"></i>
            <span>Səsləndir</span>
        `;


        speakBtn.addEventListener(
            'click',
            () => {

                speakAIText(
                    sanitizedHtml,
                    speakBtn
                );

            }
        );


        /*
           COPY BUTTON
        */

        const copyBtn =
            document.createElement(
                'button'
            );


        copyBtn.type =
            'button';


        copyBtn.classList.add(
            'ai-message-action'
        );


        copyBtn.innerHTML = `
            <i class="fa-regular fa-copy"></i>
            <span>Kopyala</span>
        `;


        copyBtn.addEventListener(
            'click',
            () => {

                copyAIText(
                    sanitizedHtml,
                    copyBtn
                );

            }
        );


        /*
           BUTTONS ADD
        */

        actionsDiv.appendChild(
            speakBtn
        );


        actionsDiv.appendChild(
            copyBtn
        );


        contentDiv.appendChild(
            actionsDiv
        );

    }


    /*
       ======================================================
       USER MESSAGE
       ======================================================
    */

    else {

        /*
           Uploaded image
        */

        if (fileBase64) {

            const img =
                document.createElement(
                    'img'
                );


            img.src =
                fileBase64;


            img.classList.add(
                'uploaded-img'
            );


            contentDiv.appendChild(
                img
            );

        }


        /*
           User text
        */

        if (text) {

            const textContainer =
                document.createElement(
                    'div'
                );


            textContainer.textContent =
                text;


            contentDiv.appendChild(
                textContainer
            );

        }

    }


    messageDiv.appendChild(
        avatarDiv
    );


    messageDiv.appendChild(
        contentDiv
    );


    chatMessages.appendChild(
        messageDiv
    );


    chatMessages.scrollTop =
        chatMessages.scrollHeight;

}


/* =========================================================
   FILE UPLOAD
   ========================================================= */

if (attachBtn) {

    attachBtn.addEventListener(
        'click',
        () => {

            fileInput.click();

        }
    );

}


if (fileInput) {

    fileInput.addEventListener(
        'change',
        (e) => {

            const file =
                e.target.files[0];


            if (!file) return;


            selectedFile =
                file;


            const reader =
                new FileReader();


            reader.onload =
                function(uploadEvent) {

                    selectedFileBase64 =
                        uploadEvent.target.result;


                    if (
                        file.type.startsWith(
                            'image/'
                        )
                    ) {

                        filePreviewImg.src =
                            selectedFileBase64;


                        filePreviewImg.style.display =
                            'block';


                        fileIconPlaceholder.style.display =
                            'none';

                    } else {

                        filePreviewImg.style.display =
                            'none';


                        fileIconPlaceholder.style.display =
                            'flex';

                    }


                    fileInfoText.textContent =
                        file.name;


                    filePreviewContainer.classList.add(
                        'active'
                    );

                };


            reader.readAsDataURL(
                file
            );

        }
    );

}


if (removeFileBtn) {

    removeFileBtn.addEventListener(
        'click',
        () => {

            selectedFile = null;

            selectedFileBase64 = null;

            fileInput.value = '';

            filePreviewContainer.classList.remove(
                'active'
            );

        }
    );

}


/* =========================================================
   MICROPHONE / SPEECH RECOGNITION
   ========================================================= */

function updateMicStyle(
    active
) {

    if (!micBtn) return;


    if (active) {

        micBtn.style.backgroundColor =
            '#1e3a8a';

        micBtn.style.transform =
            'scale(1.15)';

        micBtn.style.transition =
            'all 0.25s ease';

    } else {

        micBtn.style.backgroundColor =
            '';

        micBtn.style.transform =
            'scale(1)';

    }

}


/* =========================================================
   CREATE SPEECH RECOGNITION
   ========================================================= */

if (
    'SpeechRecognition' in window ||
    'webkitSpeechRecognition' in window
) {

    const SpeechRecognition =
        window.SpeechRecognition ||
        window.webkitSpeechRecognition;


    recognition =
        new SpeechRecognition();


    recognition.lang =
        selectedSpeechLang;


    /*
       Mobil üçün
    */

    recognition.continuous =
        false;


    recognition.interimResults =
        true;


    recognition.maxAlternatives =
        1;


    recognition.onstart =
        () => {

            isRecording =
                true;


            if (micBtn) {

                micBtn.classList.add(
                    'listening'
                );

            }


            updateMicStyle(
                true
            );

        };


    recognition.onresult =
        (event) => {

            let finalText =
                '';


            let interimText =
                '';


            /*
               Bütün nəticələri götürürük.
               Əvvəlki kodda yalnız event.results[0]
               istifadə edilirdi.
            */

            for (
                let i = event.resultIndex;
                i < event.results.length;
                i++
            ) {

                const transcript =
                    event.results[i][0].transcript;


                if (
                    event.results[i].isFinal
                ) {

                    finalText +=
                        transcript + ' ';

                } else {

                    interimText +=
                        transcript;

                }

            }


            const currentText =
                (
                    finalText ||
                    interimText
                ).trim();


            if (currentText) {

                textarea.value =
                    currentText;


                adjustTextareaHeight();

            }


            /*
               Final nəticə gəldikdə göndər.
            */

            if (finalText.trim()) {

                setTimeout(() => {

                    handleSendMessage();

                }, 250);

            }

        };


    recognition.onerror =
        (event) => {

            console.error(
                'Səs tanıma xətası:',
                event.error
            );


            isRecording =
                false;


            if (micBtn) {

                micBtn.classList.remove(
                    'listening'
                );

            }


            updateMicStyle(
                false
            );


            /*
               Bəzi normal mobil xətalarda
               istifadəçiyə alert göstərmirik.
            */

            if (
                event.error === 'not-allowed'
            ) {

                alert(
                    'Mikrofon icazəsi verilməyib. Telefonunuzun brauzer ayarlarından mikrofon icazəsini aktiv edin.'
                );

            }

        };


    recognition.onend =
        () => {

            isRecording =
                false;


            if (micBtn) {

                micBtn.classList.remove(
                    'listening'
                );

            }


            updateMicStyle(
                false
            );

        };

}


/* =========================================================
   START RECOGNITION
   ========================================================= */

function startRecognition() {

    if (!recognition) {

        return;

    }


    recognition.lang =
        selectedSpeechLang;


    try {

        recognition.start();

    } catch (error) {

        console.log(
            'Recognition artıq aktiv ola bilər.'
        );

    }

}


/* =========================================================
   MICROPHONE BUTTON
   ========================================================= */

if (micBtn) {

    micBtn.addEventListener(
        'click',
        (e) => {

            e.preventDefault();

            e.stopPropagation();


            if (!recognition) {

                alert(
                    'Bu brauzer səs tanımanı dəstəkləmir. Android-də Chrome istifadə etməyiniz tövsiyə olunur.'
                );

                return;

            }


            if (isRecording) {

                recognition.stop();

                return;

            }


            startRecognition();

        }
    );

}


/* =========================================================
   SEND MESSAGE
   ========================================================= */

async function handleSendMessage() {

    const text =
        textarea.value.trim();


    if (
        !text &&
        !selectedFileBase64
    ) {

        return;

    }


    const payloadMessage =
        text;


    const payloadImage =
        selectedFileBase64;


    /*
       User message
    */

    appendMessageUI(
        text,
        'user',
        false,
        payloadImage
    );


    saveMessageToCurrentChat(
        text,
        'user',
        false,
        payloadImage
    );


    /*
       Prompt buttons
    */

    if (premiumLessonBtn) {

        premiumLessonBtn.classList.remove(
            'active-glow'
        );

    }


    if (adaProBtn) {

        adaProBtn.classList.remove(
            'active-glow'
        );

    }


    /*
       Input təmizlə
    */

    textarea.value = '';

    adjustTextareaHeight();


    selectedFile = null;

    selectedFileBase64 = null;

    fileInput.value = '';


    if (filePreviewContainer) {

        filePreviewContainer.classList.remove(
            'active'
        );

    }


    /*
       Loading
    */

    const loadingId =
        'loading-' + Date.now();


    const loadingDiv =
        document.createElement(
            'div'
        );


    loadingDiv.classList.add(
        'message',
        'ai'
    );


    loadingDiv.id =
        loadingId;


    loadingDiv.innerHTML = `
        <div class="avatar">
            <img
                src="/ada-logo.jpeg"
                alt="ADA AI"
            >
        </div>

        <div
            class="message-content"
            style="
                color:#94a3b8;
                font-style:italic;
            "
        >
            <i class="fa-solid fa-spinner fa-spin"></i>
            Düşünür...
        </div>
    `;


    chatMessages.appendChild(
        loadingDiv
    );


    chatMessages.scrollTop =
        chatMessages.scrollHeight;


    try {

        const response =
            await fetch(
                '/api/chat',
                {
                    method: 'POST',

                    headers: {
                        'Content-Type':
                            'application/json'
                    },

                    body: JSON.stringify({

                        message:
                            payloadMessage,

                        image:
                            payloadImage

                    })

                }
            );


        const data =
            await response.json();


        const loader =
            document.getElementById(
                loadingId
            );


        if (loader) {

            loader.remove();

        }

        


        if (response.ok) {

            /*
               AI cavabı göstər
            */

            appendMessageUI(
                data.reply,
                'ai'
            );


            /*
               LocalStorage
            */

            saveMessageToCurrentChat(
                data.reply,
                'ai',
                false
            );


            /*
               VACİB:
               Burada artıq avtomatik speakResponse()
               YOXDUR.

               İstifadəçi 🔊 Səsləndir düyməsinə basır.
            */

        } else {

            const err =
                data.error ||
                "Xəta baş verdi.";


            appendMessageUI(
                err,
                'ai'
            );


            saveMessageToCurrentChat(
                err,
                'ai',
                false
            );

        }


    } catch (error) {

        const loader =
            document.getElementById(
                loadingId
            );


        if (loader) {

            loader.remove();

        }


        console.error(
            "Xəta:",
            error
        );


        const networkErr =
            "Serverlə əlaqə zamanı xəta baş verdi.";


        appendMessageUI(
            networkErr,
            'ai'
        );


        saveMessageToCurrentChat(
            networkErr,
            'ai',
            false
        );

    }

}


/* =========================================================
   SEND BUTTON
   ========================================================= */

if (sendBtn) {

    sendBtn.addEventListener(
        'click',
        handleSendMessage
    );

}


/* =========================================================
   ENTER TO SEND
   ========================================================= */

if (textarea) {

    textarea.addEventListener(
        'keydown',
        (e) => {

            if (
                e.key === 'Enter' &&
                !e.shiftKey
            ) {

                e.preventDefault();

                handleSendMessage();

            }

        }
    );

}


/* =========================================================
   MOBILE KEYBOARD
   ========================================================= */

if (textarea) {

    textarea.addEventListener(
        'blur',
        () => {

            setTimeout(() => {

                window.scrollTo(
                    0,
                    document.body.scrollHeight
                );


                chatMessages.scrollTop =
                    chatMessages.scrollHeight;


                document.body.style.height =
                    window.innerHeight + 'px';


                setTimeout(() => {

                    document.body.style.height =
                        '';

                }, 50);

            }, 150);

        }
    );

}


/* =========================================================
   MOBILE RESIZE
   ========================================================= */

window.addEventListener(
    'resize',
    () => {

        if (
            document.activeElement !== textarea
        ) {

            chatMessages.scrollTop =
                chatMessages.scrollHeight;

        }

    }
);


/* =========================================================
   SETTINGS / THEME
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        const settingsToggleBtn =
            document.getElementById(
                "settingsToggleBtn"
            );


        const settingsMenu =
            document.getElementById(
                "settingsMenu"
            );


        const themeToggleItem =
            document.getElementById(
                "themeToggleItem"
            );


        if (
            settingsToggleBtn &&
            settingsMenu
        ) {

            settingsToggleBtn.addEventListener(
                "click",
                (e) => {

                    e.stopPropagation();

                    settingsMenu.classList.toggle(
                        "active"
                    );

                }
            );


            document.addEventListener(
                "click",
                () => {

                    settingsMenu.classList.remove(
                        "active"
                    );

                }
            );

        }


        const currentTheme =
            localStorage.getItem(
                "theme"
            );


        if (
            currentTheme === "light"
        ) {

            document.body.classList.add(
                "light-mode"
            );


            if (themeToggleItem) {

                themeToggleItem.innerHTML =
                    '<i class="fa-solid fa-sun"></i><span>Qaranlıq / Açıq Mod</span>';

            }

        }


        if (themeToggleItem) {

            themeToggleItem.addEventListener(
                "click",
                (e) => {

                    e.preventDefault();


                    document.body.classList.toggle(
                        "light-mode"
                    );


                    let theme =
                        "dark";


                    if (
                        document.body.classList.contains(
                            "light-mode"
                        )
                    ) {

                        theme =
                            "light";


                        themeToggleItem.innerHTML =
                            '<i class="fa-solid fa-sun"></i><span>Qaranlıq / Açıq Mod</span>';

                    } else {

                        themeToggleItem.innerHTML =
                            '<i class="fa-solid fa-moon"></i><span>Qaranlıq / Açıq Mod</span>';

                    }


                    localStorage.setItem(
                        "theme",
                        theme
                    );

                }
            );

        }

    }
);


/* =========================================================
   MAIN LANGUAGE DROPDOWN
   ========================================================= */

document.addEventListener(
    'DOMContentLoaded',
    () => {

        const mainLanguageDropdown =
            document.getElementById(
                'languageDropdown'
            );


        const langToggleBtn =
            document.getElementById(
                'langToggleBtn'
            );


        if (
            !mainLanguageDropdown ||
            !langToggleBtn
        ) {

            return;

        }


        langToggleBtn.addEventListener(
            'click',
            (e) => {

                e.stopPropagation();

                mainLanguageDropdown.classList.toggle(
                    'active'
                );

            }
        );


        document.addEventListener(
            'click',
            (e) => {

                if (
                    !mainLanguageDropdown.contains(
                        e.target
                    )
                ) {

                    mainLanguageDropdown.classList.remove(
                        'active'
                    );

                }

            }
        );

    }
);


/* =========================================================
   INITIALIZE
   ========================================================= */

initApp();


/* =========================================================
   MOBILE SPEECH SYNTHESIS FIX
   ========================================================= */

/*
   Android Chrome bəzən səhifə yüklənəndə
   voice siyahısını dərhal vermir.
*/

if (
    'speechSynthesis' in window
) {

    setTimeout(() => {

        try {

            window.speechSynthesis.getVoices();

        } catch (e) {}

    }, 300);


    setTimeout(() => {

        try {

            window.speechSynthesis.getVoices();

        } catch (e) {}

    }, 1000);

}



</script>
</body>
</html>