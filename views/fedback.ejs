<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

/* =====================================================
   ELEMENTS
===================================================== */

const sidebar =
    document.getElementById('sidebar');

const sidebarOverlay =
    document.getElementById('sidebarOverlay');

const menuToggleBtn =
    document.getElementById('menuToggleBtn');

const closeSidebarBtn =
    document.getElementById('closeSidebarBtn');

const settingsToggleBtn =
    document.getElementById('settingsToggleBtn');

const settingsMenu =
    document.getElementById('settingsMenu');

const themeToggleItem =
    document.getElementById('themeToggleItem');


/* =====================================================
   SIDEBAR
===================================================== */

function openSidebar() {

    sidebar.classList.add('open');

    sidebar.classList.add('active');

    sidebarOverlay.classList.add('active');

}


function closeSidebar() {

    sidebar.classList.remove('open');

    sidebar.classList.remove('active');

    sidebarOverlay.classList.remove('active');

}


function toggleSidebar() {

    if (
        sidebar.classList.contains('open') ||
        sidebar.classList.contains('active')
    ) {

        closeSidebar();

    } else {

        openSidebar();

    }

}


/* =====================================================
   MOBILE MENU
===================================================== */

if (menuToggleBtn) {

    menuToggleBtn.addEventListener(
        'click',
        function(e) {

            e.stopPropagation();

            toggleSidebar();

        }
    );

}


if (closeSidebarBtn) {

    closeSidebarBtn.addEventListener(
        'click',
        closeSidebar
    );

}


if (sidebarOverlay) {

    sidebarOverlay.addEventListener(
        'click',
        closeSidebar
    );

}


/* =====================================================
   SETTINGS
===================================================== */

if (
    settingsToggleBtn &&
    settingsMenu
) {

    settingsToggleBtn.addEventListener(
        'click',
        function(e) {

            e.stopPropagation();

            const active =
                settingsMenu.classList.toggle(
                    'active'
                );


            settingsToggleBtn.classList.toggle(
                'active',
                active
            );

        }
    );

}


/* =====================================================
   OUTSIDE CLICK
===================================================== */

document.addEventListener(
    'click',
    function(e) {


        if (
            settingsMenu &&
            settingsToggleBtn
        ) {

            if (
                !settingsToggleBtn.contains(e.target) &&
                !settingsMenu.contains(e.target)
            ) {

                settingsMenu.classList.remove(
                    'active'
                );

                settingsToggleBtn.classList.remove(
                    'active'
                );

            }

        }


        if (
            window.innerWidth <= 768 &&
            (
                sidebar.classList.contains('open') ||
                sidebar.classList.contains('active')
            )
        ) {

            if (
                !sidebar.contains(e.target) &&
                !menuToggleBtn.contains(e.target)
            ) {

                closeSidebar();

            }

        }

    }
);


/* =====================================================
   THEME UI
===================================================== */

function updateThemeButton() {

    if (!themeToggleItem) return;


    const icon =
        themeToggleItem.querySelector('i');

    const text =
        themeToggleItem.querySelector('span');


    if (
        document.body.classList.contains(
            'light-mode'
        )
    ) {

        if (icon) {

            icon.className =
                'fa-solid fa-sun';

        }

    } else {

        if (icon) {

            icon.className =
                'fa-solid fa-moon';

        }

    }


    if (text) {

        text.textContent =
            'Qaranlıq / Açıq Mod';

    }

}


/* =====================================================
   APPLY THEME
===================================================== */

function applyTheme(theme) {

    if (theme === 'light') {

        document.body.classList.add(
            'light-mode'
        );

    } else {

        document.body.classList.remove(
            'light-mode'
        );

    }


    updateThemeButton();

}


/* =====================================================
   LOAD THEME
===================================================== */

const savedTheme =
    localStorage.getItem('theme');


if (savedTheme === 'light') {

    applyTheme('light');

} else {

    applyTheme('dark');

}


/* =====================================================
   THEME TOGGLE
===================================================== */

if (themeToggleItem) {

    themeToggleItem.addEventListener(
        'click',
        function(e) {

            e.preventDefault();


            const isLight =
                document.body.classList.contains(
                    'light-mode'
                );


            if (isLight) {

                applyTheme('dark');

                localStorage.setItem(
                    'theme',
                    'dark'
                );

            } else {

                applyTheme('light');

                localStorage.setItem(
                    'theme',
                    'light'
                );

            }

        }
    );

}


/* =====================================================
   ESC
===================================================== */

document.addEventListener(
    'keydown',
    function(e) {

        if (e.key === 'Escape') {

            closeSidebar();


            if (settingsMenu) {

                settingsMenu.classList.remove(
                    'active'
                );

            }


            if (settingsToggleBtn) {

                settingsToggleBtn.classList.remove(
                    'active'
                );

            }

        }

    }
);


/* =====================================================
   RATING
===================================================== */

const ratingButtons =
    document.querySelectorAll(
        '.rating-star'
    );


const ratingInput =
    document.getElementById('rating');


const ratingText =
    document.getElementById('ratingText');


const ratingLabels = {

    1: 'Çox pis',

    2: 'Pis',

    3: 'Orta',

    4: 'Yaxşı',

    5: 'Əla'

};


ratingButtons.forEach(
    function(button) {

        button.addEventListener(
            'click',
            function() {

                const rating =
                    Number(
                        button.dataset.rating
                    );


                ratingInput.value =
                    rating;


                ratingButtons.forEach(
                    function(star) {

                        const starRating =
                            Number(
                                star.dataset.rating
                            );


                        star.classList.toggle(
                            'active',
                            starRating <= rating
                        );

                    }
                );


                ratingText.textContent =
                    `${rating}/5 — ${ratingLabels[rating]}`;

            }
        );

    }
);


/* =====================================================
   FORM
===================================================== */

const feedbackForm =
    document.getElementById(
        'feedbackForm'
    );


const submitBtn =
    document.getElementById(
        'submitBtn'
    );


const successMessage =
    document.getElementById(
        'successMessage'
    );


if (feedbackForm) {

    feedbackForm.addEventListener(
        'submit',
        async function(event) {

            event.preventDefault();


            const formData =
                new FormData(
                    feedbackForm
                );


            const data =
                Object.fromEntries(
                    formData.entries()
                );


            if (
                !data.feedbackType
            ) {

                alert(
                    'Zəhmət olmasa geribildirim növünü seçin.'
                );

                return;

            }


            if (
                !data.feedbackMessage ||
                data.feedbackMessage.trim().length < 5
            ) {

                alert(
                    'Zəhmət olmasa ən azı 5 simvol uzunluğunda geribildirim yazın.'
                );

                return;

            }


            /* LOADING */

            submitBtn.disabled = true;


            submitBtn.innerHTML = `

                <i class="fa-solid fa-spinner fa-spin"></i>

                <span>
                    Göndərilir...
                </span>

            `;


            try {

                const response =
                    await fetch(
                        '/geribildirim',
                        {

                            method: 'POST',

                            headers: {

                                'Content-Type':
                                    'application/json'

                            },

                            body:
                                JSON.stringify(data)

                        }
                    );


                const result =
                    await response.json();


                if (
                    !response.ok ||
                    !result.success
                ) {

                    throw new Error(
                        result.message ||
                        'Geribildirim göndərilmədi.'
                    );

                }


                /* SUCCESS */

                successMessage.classList.add(
                    'show'
                );


                feedbackForm.reset();


                ratingInput.value = '';


                ratingButtons.forEach(
                    function(star) {

                        star.classList.remove(
                            'active'
                        );

                    }
                );


                ratingText.textContent =
                    'Reytinq seçilməyib';


                window.scrollTo({

                    top: 0,

                    behavior: 'smooth'

                });


                setTimeout(
                    function() {

                        successMessage.classList.remove(
                            'show'
                        );

                    },
                    7000
                );


            } catch (error) {

                console.error(error);


                alert(
                    error.message ||
                    'Xəta baş verdi. Yenidən cəhd edin.'
                );


            } finally {

                submitBtn.disabled = false;


                submitBtn.innerHTML = `

                    <i class="fa-solid fa-paper-plane"></i>

                    <span>
                        Geribildirimi göndər
                    </span>

                `;

            }

        }
    );

}


/* =====================================================
   LANGUAGE
===================================================== */

function applyAutoTranslation(lang) {

    const currentLang =
        lang ||
        localStorage.getItem(
            'userLanguage'
        ) ||
        'az';


    document
        .querySelectorAll('[data-lang]')
        .forEach(
            function(el) {

                const key =
                    el.getAttribute(
                        'data-lang'
                    );


                if (
                    typeof dictionary !== 'undefined' &&
                    dictionary[key]
                ) {

                    if (
                        dictionary[key][currentLang]
                    ) {

                        el.textContent =
                            dictionary[key][currentLang];

                    }

                    else if (
                        dictionary[key]['az']
                    ) {

                        el.textContent =
                            dictionary[key]['az'];

                    }

                }

                else if (
                    typeof translations !== 'undefined' &&
                    translations[currentLang] &&
                    translations[currentLang][key]
                ) {

                    el.textContent =
                        translations[currentLang][key];

                }

            }
        );

}


/* =====================================================
   DOM READY
===================================================== */

document.addEventListener(
    'DOMContentLoaded',
    function() {

        const lang =
            localStorage.getItem(
                'userLanguage'
            ) || 'az';


        applyAutoTranslation(lang);

        updateThemeButton();

    }
);


/* =====================================================
   STORAGE SYNC
===================================================== */

window.addEventListener(
    'storage',
    function(event) {


        if (
            [
                'userLanguage',
                'app_lang',
                'lang',
                'language',
                'site_language'
            ].includes(event.key)
        ) {

            applyAutoTranslation(
                event.newValue || 'az'
            );

        }


        if (event.key === 'theme') {

            applyTheme(
                event.newValue || 'dark'
            );

        }

    }
);

</script>


