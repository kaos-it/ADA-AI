<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

/* =====================================================
   ELEMENTS
===================================================== */

const sidebar =
    document.getElementById('sidebar');


const sidebarOverlay =
    document.getElementById('sidebarOverlay');


const menuToggleBtn =
    document.getElementById('menuToggleBtn');


const closeSidebarBtn =
    document.getElementById('closeSidebarBtn');


const settingsToggleBtn =
    document.getElementById('settingsToggleBtn');


const settingsMenu =
    document.getElementById('settingsMenu');


const themeToggleItem =
    document.getElementById('themeToggleItem');


/* =====================================================
   SIDEBAR
===================================================== */

function openSidebar() {

    if (!sidebar) return;

    sidebar.classList.add('open');

    sidebar.classList.add('active');

    if (sidebarOverlay) {

        sidebarOverlay.classList.add('active');

    }

}


function closeSidebar() {

    if (!sidebar) return;

    sidebar.classList.remove('open');

    sidebar.classList.remove('active');

    if (sidebarOverlay) {

        sidebarOverlay.classList.remove('active');

    }

}


function toggleSidebar() {

    if (!sidebar) return;

    if (
        sidebar.classList.contains('open') ||
        sidebar.classList.contains('active')
    ) {

        closeSidebar();

    } else {

        openSidebar();

    }

}


/* =====================================================
   MOBILE MENU
===================================================== */

if (menuToggleBtn) {

    menuToggleBtn.addEventListener(
        'click',
        function(e) {

            e.stopPropagation();

            toggleSidebar();

        }
    );

}


if (closeSidebarBtn) {

    closeSidebarBtn.addEventListener(
        'click',
        closeSidebar
    );

}


if (sidebarOverlay) {

    sidebarOverlay.addEventListener(
        'click',
        closeSidebar
    );

}


/* =====================================================
   SETTINGS
===================================================== */

if (
    settingsToggleBtn &&
    settingsMenu
) {

    settingsToggleBtn.addEventListener(
        'click',
        function(e) {

            e.stopPropagation();

            const active =
                settingsMenu.classList.toggle('active');

            settingsToggleBtn.classList.toggle(
                'active',
                active
            );

        }
    );

}


/* =====================================================
   OUTSIDE CLICK
===================================================== */

document.addEventListener(
    'click',
    function(e) {

        if (
            settingsMenu &&
            settingsToggleBtn
        ) {

            if (
                !settingsToggleBtn.contains(e.target) &&
                !settingsMenu.contains(e.target)
            ) {

                settingsMenu.classList.remove(
                    'active'
                );

                settingsToggleBtn.classList.remove(
                    'active'
                );

            }

        }


        if (
            window.innerWidth <= 768 &&
            sidebar &&
            sidebar.classList.contains('open')
        ) {

            if (
                !sidebar.contains(e.target) &&
                menuToggleBtn &&
                !menuToggleBtn.contains(e.target)
            ) {

                closeSidebar();

            }

        }

    }
);


/* =====================================================
   THEME BUTTON
===================================================== */

function updateThemeButton() {

    if (!themeToggleItem) return;


    const icon =
        themeToggleItem.querySelector('i');


    const text =
        themeToggleItem.querySelector('span');


    if (
        document.body.classList.contains(
            'light-mode'
        )
    ) {

        if (icon) {

            icon.className =
                'fa-solid fa-sun';

        }

    } else {

        if (icon) {

            icon.className =
                'fa-solid fa-moon';

        }

    }


    if (text) {

        text.textContent =
            'Qaranlıq / Açıq Mod';

    }

}


/* =====================================================
   APPLY THEME
===================================================== */

function applyTheme(theme) {

    if (theme === 'light') {

        document.body.classList.add(
            'light-mode'
        );

    } else {

        document.body.classList.remove(
            'light-mode'
        );

    }


    updateThemeButton();

}


/* =====================================================
   LOAD THEME
===================================================== */

const savedTheme =
    localStorage.getItem('theme');


if (savedTheme === 'light') {

    applyTheme('light');

} else {

    applyTheme('dark');

}


/* =====================================================
   THEME TOGGLE
===================================================== */

if (themeToggleItem) {

    themeToggleItem.addEventListener(
        'click',
        function(e) {

            e.preventDefault();

            const isLight =
                document.body.classList.contains(
                    'light-mode'
                );


            if (isLight) {

                applyTheme('dark');

                localStorage.setItem(
                    'theme',
                    'dark'
                );

            } else {

                applyTheme('light');

                localStorage.setItem(
                    'theme',
                    'light'
                );

            }

        }
    );

}


/* =====================================================
   ESC KEY
===================================================== */

document.addEventListener(
    'keydown',
    function(e) {

        if (e.key === 'Escape') {

            closeSidebar();


            if (settingsMenu) {

                settingsMenu.classList.remove(
                    'active'
                );

            }


            if (settingsToggleBtn) {

                settingsToggleBtn.classList.remove(
                    'active'
                );

            }

        }

    }
);


/* =====================================================
   LANGUAGE
===================================================== */

function applyAutoTranslation(lang) {

    const currentLang =
        lang ||
        localStorage.getItem('userLanguage') ||
        'az';


    document
        .querySelectorAll('[data-lang]')
        .forEach(function(el) {

            const key =
                el.getAttribute('data-lang');


            if (
                typeof dictionary !== 'undefined' &&
                dictionary[key]
            ) {

                if (
                    dictionary[key][currentLang]
                ) {

                    el.textContent =
                        dictionary[key][currentLang];

                }

                else if (
                    dictionary[key]['az']
                ) {

                    el.textContent =
                        dictionary[key]['az'];

                }

            }

            else if (
                typeof translations !== 'undefined' &&
                translations[currentLang] &&
                translations[currentLang][key]
            ) {

                el.textContent =
                    translations[currentLang][key];

            }

        });

}


/* =====================================================
   DOM READY
===================================================== */

document.addEventListener(
    'DOMContentLoaded',
    function() {

        const lang =
            localStorage.getItem(
                'userLanguage'
            ) || 'az';


        applyAutoTranslation(lang);

        updateThemeButton();

    }
);


/* =====================================================
   STORAGE SYNC
===================================================== */

window.addEventListener(
    'storage',
    function(event) {

        if (
            [
                'userLanguage',
                'app_lang',
                'lang',
                'language',
                'site_language'
            ].includes(event.key)
        ) {

            applyAutoTranslation(
                event.newValue || 'az'
            );

        }


        if (event.key === 'theme') {

            applyTheme(
                event.newValue || 'dark'
            );

        }

    }
);

</script>


</body>

