<script>
    /* =========================================================
   ADA STUDENT AI - CLEAN MOBILE FRIENDLY VERSION
   ========================================================= */

const userEmail = "<%= locals.user ? user.email : 'guest' %>";
const userPicture = "<%= locals.user && (user.picture || user.profile_picture) ? (user.picture || user.profile_picture) : '' %>";

// Qonaqdırsa sessionStorage (səhifə/tab bağlananda silinir), 
// login olubsa localStorage (daimi qalır) istifadə edirik.
const isGuest = !userEmail || userEmail === 'guest';
const activeStorage = isGuest ? sessionStorage : localStorage;

const STORAGE_KEY = `ada_ai_chats_${userEmail}`;
const CURRENT_CHAT_KEY = `ada_ai_current_chat_${userEmail}`;

// DOM Elementləri
const $ = id => document.getElementById(id);
const textarea = $('userInput');
const chatMessages = $('chatMessages');
const sendBtn = $('sendBtn');
const attachBtn = $('attachBtn');
const fileInput = $('fileInput');
const micBtn = $('micBtn');
const micWrapper = $('micWrapper');
const langDropdown = $('langDropdown');
const changeLangBtn = $('changeLangBtn');
const newChatBtn = $('newChatBtn');
const chatHistoryList = $('chatHistoryList');
const filePreviewContainer = $('filePreviewContainer');
const filePreviewImg = $('filePreviewImg');
const fileIconPlaceholder = $('fileIconPlaceholder');
const fileInfoText = $('fileInfoText');
const removeFileBtn = $('removeFileBtn');
const sidebar = $('sidebar');
const menuToggleBtn = $('menuToggleBtn');
const closeSidebarBtn = $('closeSidebarBtn');
const sidebarOverlay = $('sidebarOverlay');
const premiumLessonBtn = $('premiumLessonBtn');
const adaProBtn = $('adaProBtn');

// Dəyişənlər
let currentChatId = null;
let selectedFile = null;
let selectedFileBase64 = null;
let selectedSpeechLang = localStorage.getItem('ada_speech_lang') || 'az-AZ';
let recognition = null;
let isRecording = false;
let speechVoices = [];
let activeSpeechButton = null;
let activeUtterance = null;

const defaultWelcomeMsg = {
    text: "Salam! Mən ADA Student Aİ köməkçisiyəm. ADA Group tərəfindən dərslərinizə dəstək olmaq üçün yaradılmışam. Dərslərinizin fotosunu və ya səsli mesajınızı mənə ataraq ətraflı izahını ala bilərsiniz!",
    sender: "ai"
};

/* ===================== STORAGE MANAGEMENT ===================== */

function getStoredChats() {
    try {
        return JSON.parse(activeStorage.getItem(STORAGE_KEY)) || {};
    } catch (e) {
        console.error("Storage oxuma xətası:", e);
        return {};
    }
}

function saveStoredChats(chats) {
    try {
        activeStorage.setItem(STORAGE_KEY, JSON.stringify(chats));
    } catch (e) {
        console.error("Storage yaddaş xətası:", e);
    }
}

/* ===================== CHAT MANAGEMENT ===================== */

function initApp() {
    const chats = getStoredChats();
    let savedCurrentId = activeStorage.getItem(CURRENT_CHAT_KEY);

    if (!savedCurrentId || !chats[savedCurrentId]) {
        savedCurrentId = createNewChat(false);
    } else {
        currentChatId = savedCurrentId;
    }

    renderSidebarHistory();
    loadChat(currentChatId);
}

function createNewChat(shouldRender = true) {
    const chats = getStoredChats();
    const newId = 'chat_' + Date.now();

    chats[newId] = { id: newId, title: "Yeni Söhbət", messages: [defaultWelcomeMsg] };
    saveStoredChats(chats);
    currentChatId = newId;
    activeStorage.setItem(CURRENT_CHAT_KEY, newId);

    if (shouldRender) {
        renderSidebarHistory();
        loadChat(newId);
    }
    return newId;
}

function loadChat(chatId) {
    const chats = getStoredChats();
    if (!chats[chatId]) return;

    stopCurrentSpeech();
    currentChatId = chatId;
    activeStorage.setItem(CURRENT_CHAT_KEY, chatId);
    chatMessages.innerHTML = '';

    (chats[chatId].messages || []).forEach(msg => {
        appendMessageUI(msg.text, msg.sender, msg.isHtml || false, msg.fileBase64 || null);
    });

    renderSidebarHistory();
}

function saveMessageToCurrentChat(text, sender, isHtml = false, fileBase64 = null) {
    const chats = getStoredChats();
    if (!chats[currentChatId]) {
        chats[currentChatId] = { id: currentChatId, title: "Yeni Söhbət", messages: [] };
    }

    const chat = chats[currentChatId];
    chat.messages.push({ text, sender, isHtml, fileBase64 });

    if (sender === 'user' && chat.title === "Yeni Söhbət") {
        const plainText = String(text || '').replace(/<[^>]*>?/gm, '').trim();
        chat.title = plainText ? plainText.substring(0, 25) + (plainText.length > 25 ? '...' : '') : "Fayl/Şəkil";
    }

    saveStoredChats(chats);
    renderSidebarHistory();
}

/* ===================== SIDEBAR ===================== */

function renderSidebarHistory() {
    if (!chatHistoryList) return;
    const chats = getStoredChats();
    chatHistoryList.innerHTML = '';

    const chatKeys = Object.keys(chats).reverse();
    if (!chatKeys.length) {
        chatHistoryList.innerHTML = `<div style="padding:15px;text-align:center;color:#94a3b8;font-size:13px">Hələ heç bir söhbət yoxdur</div>`;
        return;
    }

    chatKeys.forEach(key => {
        const chat = chats[key];
        const item = document.createElement('div');
        item.className = `history-item ${key === currentChatId ? 'active' : ''}`;
        item.textContent = chat.title || "Yeni Söhbət";

        item.addEventListener('click', () => {
            loadChat(key);
            if (window.innerWidth <= 768) closeSidebar();
        });
        chatHistoryList.appendChild(item);
    });
}

const openSidebar = () => { sidebar?.classList.add('open'); sidebarOverlay?.classList.add('active'); };
const closeSidebar = () => { sidebar?.classList.remove('open'); sidebarOverlay?.classList.remove('active'); };

newChatBtn?.addEventListener('click', () => { createNewChat(true); if (window.innerWidth <= 768) closeSidebar(); });
menuToggleBtn?.addEventListener('click', () => sidebar?.classList.contains('open') ? closeSidebar() : openSidebar());
closeSidebarBtn?.addEventListener('click', closeSidebar);
sidebarOverlay?.addEventListener('click', closeSidebar);

/* ===================== PROMPT BUTTONS ===================== */

function setPromptText(str, btn) {
    if (!btn || !textarea) return;
    btn.classList.toggle('active-glow');
    textarea.value = btn.classList.contains('active-glow') ? str : '';
    adjustTextareaHeight();
}

premiumLessonBtn?.addEventListener('click', () => {
    adaProBtn?.classList.remove('active-glow');
    setPromptText("Salam, mən premium dərs seçmək istəyirəm. Hansı istiqamətlər mövcuddur?", premiumLessonBtn);
});

adaProBtn?.addEventListener('click', () => {
    premiumLessonBtn?.classList.remove('active-glow');
    setPromptText("Salam, ADA PRO imkanları haqqında məlumat verin.", adaProBtn);
});

/* ===================== TEXTAREA ===================== */

function adjustTextareaHeight() {
    if (!textarea) return;
    textarea.style.height = 'auto';
    textarea.style.height = Math.min(textarea.scrollHeight, 140) + 'px';
}
textarea?.addEventListener('input', adjustTextareaHeight);

/* ===================== SPEECH & VOICES ===================== */

const speechLangOptions = document.querySelectorAll('#langDropdown .lang-option');

function updateSelectedSpeechLanguageUI() {
    speechLangOptions.forEach(opt => {
        const lang = opt.getAttribute('data-lang');
        opt.classList.toggle('active-lang', lang === selectedSpeechLang);
        if (lang === selectedSpeechLang && changeLangBtn) changeLangBtn.textContent = opt.textContent.trim();
    });
}

speechLangOptions.forEach(opt => {
    opt.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
        selectedSpeechLang = opt.getAttribute('data-lang') || 'az-AZ';
        localStorage.setItem('ada_speech_lang', selectedSpeechLang);
        if (recognition) recognition.lang = selectedSpeechLang;
        updateSelectedSpeechLanguageUI();
        langDropdown?.classList.remove('show');
    });
});

changeLangBtn?.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); langDropdown?.classList.toggle('show'); });
document.addEventListener('click', e => { if (micWrapper && !micWrapper.contains(e.target)) langDropdown?.classList.remove('show'); });
updateSelectedSpeechLanguageUI();

function loadSpeechVoices() {
    if ('speechSynthesis' in window) speechVoices = window.speechSynthesis.getVoices();
}

function getBestVoice(language) {
    const voices = speechVoices.length ? speechVoices : window.speechSynthesis.getVoices();
    if (!voices.length) return null;
    const lang = (language || 'az-AZ').toLowerCase();
    const prefix = lang.split('-')[0];

    return voices.find(v => v.lang.toLowerCase() === lang) ||
           voices.find(v => v.lang.toLowerCase().startsWith(prefix)) ||
           voices.find(v => v.lang.toLowerCase().startsWith(prefix === 'az' ? 'tr' : 'ru')) ||
           voices[0];
}

if ('speechSynthesis' in window) {
    loadSpeechVoices();
    window.speechSynthesis.onvoiceschanged = loadSpeechVoices;
}

const detectLanguage = text => {
    if (!text) return 'az-AZ';
    if (/[\u0600-\u06FF]/.test(text)) return 'ar-SA';
    if (/[а-яА-ЯёЁ]/.test(text)) return 'ru-RU';
    if (/[əıöüçşğƏİÖÜÇŞĞ]/.test(text)) return 'az-AZ';
    if (/[çğıöşüÇĞİÖŞÜ]/.test(text)) return 'tr-TR';
    return 'en-US';
};

function getCleanSpeechText(html) {
    const temp = document.createElement('div');
    temp.innerHTML = html || '';
    return (temp.innerText || temp.textContent || '')
        .replace(/[*_#`•]/g, '').replace(/\[(.*?)\]\(.*?\)/g, '$1').replace(/\s+/g, ' ').trim();
}

/* ===================== TEXT TO SPEECH & COPY ===================== */

function resetSpeechButton(button) {
    if (!button) return;
    button.classList.remove('speaking');
    const icon = button.querySelector('i'), span = button.querySelector('span');
    if (icon) icon.className = 'fa-solid fa-volume-high';
    if (span) span.textContent = 'Səsləndir';
}

function stopCurrentSpeech() {
    if ('speechSynthesis' in window) window.speechSynthesis.cancel();
    resetSpeechButton(activeSpeechButton);
    activeSpeechButton = null;
    activeUtterance = null;
}

function speakAIText(htmlText, button) {
    if (!('speechSynthesis' in window)) return alert('Səsli oxuma dəstəklənmir.');
    if (activeSpeechButton === button && window.speechSynthesis.speaking) return stopCurrentSpeech();
    
    stopCurrentSpeech();
    const cleanText = getCleanSpeechText(htmlText);
    if (!cleanText) return;

    const lang = detectLanguage(cleanText);
    const utterance = new SpeechSynthesisUtterance(cleanText);
    utterance.lang = getBestVoice(lang)?.lang || lang;
    utterance.voice = getBestVoice(lang);
    utterance.rate = 0.88;

    activeSpeechButton = button;
    activeUtterance = utterance;
    button.classList.add('speaking');
    
    const icon = button.querySelector('i'), span = button.querySelector('span');
    if (icon) icon.className = 'fa-solid fa-stop';
    if (span) span.textContent = 'Dayandır';

    const finish = () => { if (activeUtterance === utterance) { resetSpeechButton(button); activeSpeechButton = null; activeUtterance = null; } };
    utterance.onend = utterance.onerror = finish;
    window.speechSynthesis.speak(utterance);
}

async function copyAIText(htmlText, button) {
    const cleanText = getCleanSpeechText(htmlText);
    if (!cleanText) return;
    try {
        await navigator.clipboard.writeText(cleanText);
        button.classList.add('copied');
        const icon = button.querySelector('i'), span = button.querySelector('span');
        if (icon) icon.className = 'fa-solid fa-check';
        if (span) span.textContent = 'Kopyalandı';
        setTimeout(() => {
            button.classList.remove('copied');
            if (icon) icon.className = 'fa-regular fa-copy';
            if (span) span.textContent = 'Kopyala';
        }, 1800);
    } catch (e) {
        alert('Kopyalamaq mümkün olmadı.');
    }
}

/* ===================== MESSAGE UI ===================== */

function appendMessageUI(text, sender, isHtml = false, fileBase64 = null) {
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${sender}`;

    const avatarDiv = document.createElement('div');
    avatarDiv.className = 'avatar';
    
    if (sender === 'ai') {
        avatarDiv.innerHTML = `<img src="/ada-logo.jpeg" alt="ADA AI">`;
    } else {
        avatarDiv.innerHTML = userPicture ? `<img src="${userPicture}" alt="User">` : `<i class="fa-solid fa-user"></i>`;
    }

    const contentDiv = document.createElement('div');
    contentDiv.className = 'message-content';

    if (sender === 'ai') {
        contentDiv.innerHTML = DOMPurify.sanitize(marked.parse(text || ''), { ADD_ATTR: ['target'] });
        
        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'ai-message-actions';
        
        const speakBtn = document.createElement('button');
        speakBtn.type = 'button';
        speakBtn.className = 'ai-message-action';
        speakBtn.innerHTML = `<i class="fa-solid fa-volume-high"></i><span>Səsləndir</span>`;
        speakBtn.addEventListener('click', () => speakAIText(contentDiv.innerHTML, speakBtn));

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'ai-message-action';
        copyBtn.innerHTML = `<i class="fa-regular fa-copy"></i><span>Kopyala</span>`;
        copyBtn.addEventListener('click', () => copyAIText(contentDiv.innerHTML, copyBtn));

        actionsDiv.append(speakBtn, copyBtn);
        contentDiv.appendChild(actionsDiv);
    } else {
        if (fileBase64) contentDiv.innerHTML += `<img src="${fileBase64}" class="uploaded-img">`;
        if (text) {
            const textContainer = document.createElement('div');
            textContainer.textContent = text;
            contentDiv.appendChild(textContainer);
        }
    }

    messageDiv.append(avatarDiv, contentDiv);
    chatMessages.appendChild(messageDiv);
    chatMessages.scrollTop = chatMessages.scrollHeight;
}

/* ===================== FILE UPLOAD ===================== */

attachBtn?.addEventListener('click', () => fileInput?.click());
fileInput?.addEventListener('change', e => {
    const file = e.target.files?.[0];
    if (!file) return;
    selectedFile = file;

    const reader = new FileReader();
    reader.onload = event => {
        selectedFileBase64 = event.target.result;
        if (file.type.startsWith('image/')) {
            filePreviewImg.src = selectedFileBase64;
            filePreviewImg.style.display = 'block';
            fileIconPlaceholder.style.display = 'none';
        } else {
            filePreviewImg.style.display = 'none';
            fileIconPlaceholder.style.display = 'flex';
        }
        fileInfoText.textContent = file.name;
        filePreviewContainer.classList.add('active');
    };
    reader.readAsDataURL(file);
});

removeFileBtn?.addEventListener('click', () => {
    selectedFile = null;
    selectedFileBase64 = null;
    if (fileInput) fileInput.value = '';
    filePreviewImg?.removeAttribute('src');
    filePreviewContainer?.classList.remove('active');
});

/* ===================== SPEECH RECOGNITION ===================== */

const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
if (SpeechRecognition) {
    recognition = new SpeechRecognition();
    recognition.lang = selectedSpeechLang;
    recognition.continuous = false;
    recognition.interimResults = true;

    recognition.onstart = () => { isRecording = true; micBtn?.classList.add('listening'); };
    recognition.onresult = event => {
        let text = Array.from(event.results).map(r => r[0].transcript).join('');
        if (text && textarea) { textarea.value = text; adjustTextareaHeight(); }
        if (event.results[0].isFinal) handleSendMessage();
    };
    recognition.onerror = recognition.onend = () => { isRecording = false; micBtn?.classList.remove('listening'); };
}

micBtn?.addEventListener('click', e => {
    e.preventDefault();
    if (!recognition) return alert('Səs tanıma dəstəklənmir.');
    isRecording ? recognition.stop() : recognition.start();
});

/* ===================== SEND MESSAGE ===================== */

async function handleSendMessage() {
    const text = textarea.value.trim();
    if (!text && !selectedFileBase64) return;

    const payloadMsg = text, payloadImg = selectedFileBase64;
    stopCurrentSpeech();

    appendMessageUI(text, 'user', false, payloadImg);
    saveMessageToCurrentChat(text, 'user', false, payloadImg);

    premiumLessonBtn?.classList.remove('active-glow');
    adaProBtn?.classList.remove('active-glow');
    textarea.value = '';
    adjustTextareaHeight();
    selectedFile = selectedFileBase64 = null;
    if (fileInput) fileInput.value = '';
    filePreviewContainer?.classList.remove('active');

    const loadingId = 'loading-' + Date.now();
    const loadingDiv = document.createElement('div');
    loadingDiv.className = 'message ai';
    loadingDiv.id = loadingId;
    loadingDiv.innerHTML = `<div class="avatar"><img src="/ada-logo.jpeg"></div><div class="message-content" style="color:#94a3b8;font-style:italic"><i class="fa-solid fa-spinner fa-spin"></i> Fikirləşirəm...</div>`;
    chatMessages.appendChild(loadingDiv);
    chatMessages.scrollTop = chatMessages.scrollHeight;

    try {
        const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: payloadMsg, image: payloadImg })
        });
        const data = await res.json();
        loadingDiv.remove();

        const reply = res.ok ? (data.reply || 'Cavab boşdur.') : (data.error || 'Xəta baş verdi.');
        appendMessageUI(reply, 'ai');
        saveMessageToCurrentChat(reply, 'ai');
    } catch (e) {
        loadingDiv.remove();
        appendMessageUI('Serverlə əlaqə xətası.', 'ai');
    }
}

sendBtn?.addEventListener('click', handleSendMessage);
textarea?.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSendMessage(); } });

/* ===================== SETTINGS & INIT ===================== */

function initSettings() {
    const settingsToggleBtn = $('settingsToggleBtn'), settingsMenu = $('settingsMenu'), themeToggleItem = $('themeToggleItem');
    settingsToggleBtn?.addEventListener('click', e => { e.stopPropagation(); settingsMenu?.classList.toggle('active'); });
    document.addEventListener('click', () => settingsMenu?.classList.remove('active'));

    if (localStorage.getItem('theme') === 'light') document.body.classList.add('light-mode');

    const updateTheme = () => {
        if (!themeToggleItem) return;
        const isLight = document.body.classList.contains('light-mode');
        themeToggleItem.innerHTML = `<i class="fa-solid ${isLight ? 'fa-sun' : 'fa-moon'}"></i><span>Qaranlıq / Açıq Mod</span>`;
    };
    updateTheme();

    themeToggleItem?.addEventListener('click', e => {
        e.preventDefault();
        document.body.classList.toggle('light-mode');
        localStorage.setItem('theme', document.body.classList.contains('light-mode') ? 'light' : 'dark');
        updateTheme();
    });
}

function initMainLanguageDropdown() {
    const dropdown = $('languageDropdown'), toggleBtn = $('langToggleBtn');
    if (!dropdown || !toggleBtn) return;
    toggleBtn.addEventListener('click', e => { e.stopPropagation(); dropdown.classList.toggle('active'); });
    document.addEventListener('click', e => { if (!dropdown.contains(e.target)) dropdown.classList.remove('active'); });
}

initApp();
initSettings();
initMainLanguageDropdown();
loadSpeechVoices();
setTimeout(loadSpeechVoices, 500);
</script>

