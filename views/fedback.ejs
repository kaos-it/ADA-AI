<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Geribildirim - ADA Student AI</title>

<!-- Font Awesome -->
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
>

<!-- Markdown Parser & DOMPurify -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
<script src="/js/language.js"></script>
<script src="https://pl31471578.profitableratecpmnetwork.com/af/e6/22/afe622a8e673f24563ea9ff5f00b51df.js"></script>
<link rel="icon" type="image/jpeg" href="/ada-logo.jpeg">


<style>

/* =====================================================
   ROOT
===================================================== */

:root {

    --bg: #020617;

    --sidebar: #0f172a;

    --sidebar-hover: #1e293b;

    --card: #0f172a;

    --border: #1e293b;

    --text: #f8fafc;

    --muted: #94a3b8;

    --primary: #2563eb;

    --primary-hover: #1d4ed8;

    --blue: #60a5fa;

    --purple: #818cf8;

    --orange: #f59e0b;

    --green: #22c55e;

    --danger: #ef4444;

    --shadow: rgba(0,0,0,.25);

}


/* =====================================================
   RESET
===================================================== */

* {

    box-sizing: border-box;

    margin: 0;

    padding: 0;

    font-family:
        'Segoe UI',
        Tahoma,
        Geneva,
        Verdana,
        sans-serif;

}


html {

    scroll-behavior: smooth;

}


body {

    background: var(--bg);

    color: var(--text);

    min-height: 100vh;

    overflow-x: hidden;

    transition:
        background-color .3s ease,
        color .3s ease;

}


/* =====================================================
   SIDEBAR
===================================================== */

.sidebar {

    position: fixed;

    top: 0;
    left: 0;

    width: 280px;
    height: 100vh;

    background: var(--sidebar);

    color: var(--text);

    display: flex;
    flex-direction: column;

    z-index: 1000;

    border-right: 1px solid var(--border);

    transition:
        transform .3s ease,
        background-color .3s ease,
        border-color .3s ease;

}


/* =====================================================
   SIDEBAR HEADER
===================================================== */

.sidebar-header {

    height: 72px;

    padding: 0 17px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    border-bottom: 1px solid var(--border);

    flex-shrink: 0;

}


.logo-area {

    display: flex;

    align-items: center;

    gap: 11px;

    min-width: 0;

}


.sidebar-logo {

    width: 36px;
    height: 36px;

    border-radius: 50%;

    object-fit: cover;

    flex-shrink: 0;

}


.sidebar-title {

    font-size: 16px;

    font-weight: 700;

    letter-spacing: -.4px;

    white-space: nowrap;

}


.close-sidebar-btn {

    width: 34px;
    height: 34px;

    border: none;

    background: transparent;

    color: #94a3b8;

    border-radius: 8px;

    cursor: pointer;

    font-size: 18px;

    display: none;

    align-items: center;

    justify-content: center;

}


.close-sidebar-btn:hover {

    background: var(--sidebar-hover);

    color: #fff;

}


/* =====================================================
   CHAT BUTTON
===================================================== */

.sidebar-action-area {

    padding: 16px;

}


.new-chat-btn {

    width: 100%;

    min-height: 44px;

    border: none;

    border-radius: 9px;

    background: var(--primary);

    color: #fff;

    text-decoration: none;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    font-size: 14px;

    font-weight: 600;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;

}


.new-chat-btn:hover {

    background: var(--primary-hover);

    transform: translateY(-1px);

    box-shadow:
        0 6px 18px rgba(37,99,235,.22);

}


/* =====================================================
   SIDEBAR CONTENT
===================================================== */

.sidebar-content {

    flex: 1;

    overflow-y: auto;

    padding: 0 12px 15px;

}


.sidebar-content::-webkit-scrollbar {

    width: 5px;

}


.sidebar-content::-webkit-scrollbar-track {

    background: transparent;

}


.sidebar-content::-webkit-scrollbar-thumb {

    background: #334155;

    border-radius: 20px;

}


/* =====================================================
   MENU
===================================================== */

.sidebar-section-title {

    color: #64748b;

    font-size: 11px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .8px;

    padding: 10px 10px 7px;

}


.sidebar-link {

    width: 100%;

    padding: 10px 11px;

    display: flex;

    align-items: center;

    gap: 11px;

    color: #cbd5e1;

    background: transparent;

    border: none;

    border-radius: 8px;

    text-decoration: none;

    font-size: 13.5px;

    margin-bottom: 3px;

    transition:
        background .2s ease,
        color .2s ease;

}


.sidebar-link i {

    width: 19px;

    text-align: center;

    font-size: 14px;

}


.sidebar-link:hover {

    background: var(--sidebar-hover);

    color: #fff;

}


.sidebar-link.active {

    background: rgba(37,99,235,.14);

    color: #60a5fa;

}


/* =====================================================
   SIDEBAR FOOTER
===================================================== */

.sidebar-footer {

    padding: 14px 15px 15px;

    border-top: 1px solid var(--border);

    background: var(--sidebar);

    flex-shrink: 0;

    transition:
        background .3s ease,
        border-color .3s ease;

}


/* =====================================================
   SETTINGS
===================================================== */

.settings-dropdown-wrapper {

    position: relative;

}


.settings-toggle-btn {

    width: 100%;

    min-height: 42px;

    border: none;

    background: transparent;

    color: #cbd5e1;

    border-radius: 8px;

    padding: 10px 11px;

    display: flex;

    align-items: center;

    gap: 10px;

    font-size: 13.5px;

    cursor: pointer;

    transition:
        background .2s ease,
        color .2s ease;

}


.settings-toggle-btn:hover,
.settings-toggle-btn.active {

    background: var(--sidebar-hover);

    color: #fff;

}


.settings-toggle-btn .arrow {

    margin-left: auto;

    font-size: 11px;

    transition: transform .2s ease;

}


.settings-toggle-btn.active .arrow {

    transform: rotate(180deg);

}


/* =====================================================
   SETTINGS MENU
===================================================== */

.settings-menu {

    position: absolute;

    left: 0;

    bottom: calc(100% + 8px);

    width: 100%;

    padding: 5px;

    background: #1e293b;

    border: 1px solid #334155;

    border-radius: 10px;

    box-shadow:
        0 15px 35px rgba(0,0,0,.3);

    display: none;

    z-index: 50;

}


.settings-menu.active {

    display: block;

}


.settings-item {

    width: 100%;

    padding: 11px 12px;

    display: flex;

    align-items: center;

    gap: 10px;

    border-radius: 7px;

    color: #f8fafc;

    text-decoration: none;

    font-size: 13px;

    background: transparent;

    border: none;

    cursor: pointer;

    text-align: left;

    transition:
        background .2s ease,
        color .2s ease;

}


.settings-item i {

    width: 18px;

    text-align: center;

}


.settings-item:hover {

    background: #334155;

}


/* =====================================================
   USER PROFILE
===================================================== */

.user-profile {

    margin-top: 9px;

    min-height: 55px;

    padding: 8px;

    display: flex;

    align-items: center;

    gap: 9px;

    border-radius: 9px;

    background: rgba(0,0,0,.18);

    min-width: 0;

}


.user-avatar {

    width: 38px;
    height: 38px;

    border-radius: 50%;

    overflow: hidden;

    background: #334155;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #cbd5e1;

    flex-shrink: 0;

}


.user-avatar img {

    width: 100%;
    height: 100%;

    object-fit: cover;

}


.user-info {

    flex: 1;

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.user-name {

    color: #f8fafc;

    font-size: 13px;

    font-weight: 650;

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.user-email {

    color: #94a3b8;

    font-size: 10.5px;

    margin-top: 2px;

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.logout-btn {

    width: 32px;
    height: 32px;

    border-radius: 7px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #94a3b8;

    text-decoration: none;

    flex-shrink: 0;

    transition:
        background .2s ease,
        color .2s ease;

}


.logout-btn:hover {

    background: rgba(239,68,68,.12);

    color: #ef4444;

}


/* =====================================================
   LOGIN
===================================================== */

.login-btn {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    width: 100%;

    padding: 11px;

    border-radius: 8px;

    background: rgba(34,197,94,.10);

    border: 1px solid rgba(34,197,94,.20);

    color: #4ade80;

    text-decoration: none;

    font-size: 13px;

    font-weight: 600;

}


.login-btn:hover {

    background: rgba(34,197,94,.17);

}


/* =====================================================
   OVERLAY
===================================================== */

.sidebar-overlay {

    position: fixed;

    inset: 0;

    background: rgba(0,0,0,.55);

    backdrop-filter: blur(2px);

    z-index: 999;

    display: none;

}


.sidebar-overlay.active {

    display: block;

}


/* =====================================================
   MAIN
===================================================== */

.main-content {

    margin-left: 280px;

    width: calc(100% - 280px);

    min-height: 100vh;

    padding: 40px;

    transition:
        background .3s ease,
        color .3s ease;

}


.feedback-container {

    max-width: 1000px;

    margin: 0 auto;

}


/* =====================================================
   MOBILE HEADER
===================================================== */

.mobile-header {

    display: none;

    position: fixed;

    top: 0;
    left: 0;
    right: 0;

    height: 60px;

    z-index: 1001;

    padding: 0 15px;

    background: var(--sidebar);

    border-bottom: 1px solid var(--border);

    align-items: center;

    transition:
        background .3s ease,
        border-color .3s ease;

}


.mobile-menu-btn {

    width: 38px;
    height: 38px;

    border: none;

    border-radius: 8px;

    background: transparent;

    color: var(--text);

    font-size: 20px;

    cursor: pointer;

}


.mobile-menu-btn:hover {

    background: var(--sidebar-hover);

}


.mobile-brand {

    display: flex;

    align-items: center;

    gap: 9px;

    margin-left: 8px;

    font-weight: 700;

    font-size: 15px;

    color: var(--text);

}


.mobile-brand img {

    width: 31px;
    height: 31px;

    border-radius: 50%;

    object-fit: cover;

}


/* =====================================================
   HEADER
===================================================== */

.feedback-header {

    padding-bottom: 20px;

    margin-bottom: 30px;

    border-bottom: 1px solid var(--border);

    display: flex;

    align-items: center;

    position: relative;

}


/* =====================================================
   HEADER AD
===================================================== */

.header-ad {

    position: absolute;

    right: calc(100% + 18px);

    top: -5px;

    width: 280px;

    min-height: 90px;

    display: flex;

    align-items: flex-start;

    justify-content: center;

    overflow: hidden;

    z-index: 5;

}


.header-ad #container-c2b1e42d47356f4b1bfccc63299a1a23 {

    width: 100%;

    max-width: 280px;

}


/* =====================================================
   HEADER TITLE
===================================================== */

.feedback-header h1 {

    display: flex;

    align-items: center;

    gap: 12px;

    font-size: 25px;

    font-weight: 650;

    color: var(--text);

}


.feedback-header h1 i {

    color: var(--blue);

}


/* =====================================================
   INTRO CARD
===================================================== */

.feedback-intro {

    background:
        linear-gradient(
            135deg,
            rgba(37,99,235,.12),
            rgba(129,140,248,.07)
        );

    border: 1px solid rgba(96,165,250,.18);

    border-radius: 14px;

    padding: 24px;

    margin-bottom: 20px;

    position: relative;

    overflow: hidden;

}


.feedback-intro::after {

    content: "";

    position: absolute;

    width: 160px;
    height: 160px;

    right: -70px;
    top: -70px;

    border-radius: 50%;

    background: rgba(96,165,250,.08);

}


.feedback-intro h2 {

    display: flex;

    align-items: center;

    gap: 10px;

    color: #93c5fd;

    font-size: 19px;

    font-weight: 650;

    margin-bottom: 10px;

    position: relative;

    z-index: 1;

}


.feedback-intro h2 i {

    color: #60a5fa;

}


.feedback-intro p {

    color: var(--muted);

    font-size: 14.5px;

    line-height: 1.7;

    max-width: 850px;

    position: relative;

    z-index: 1;

}


/* =====================================================
   FEEDBACK GRID
===================================================== */

.feedback-layout {

    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        300px;

    gap: 18px;

    align-items: start;

}


/* =====================================================
   CARDS
===================================================== */

.feedback-card {

    background: var(--card);

    border: 1px solid var(--border);

    border-radius: 14px;

    padding: 24px;

    margin-bottom: 18px;

    transition:
        background .3s ease,
        border-color .3s ease,
        box-shadow .3s ease;

}


.feedback-card:hover {

    box-shadow:
        0 8px 25px rgba(0,0,0,.08);

}


.card-title {

    display: flex;

    align-items: center;

    gap: 10px;

    color: #93c5fd;

    font-size: 18px;

    font-weight: 650;

    margin-bottom: 8px;

}


.card-title i {

    width: 22px;

    text-align: center;

}


.card-description {

    color: var(--muted);

    font-size: 13.5px;

    line-height: 1.6;

    margin-bottom: 22px;

}


/* =====================================================
   FORM
===================================================== */

.form-group {

    margin-bottom: 19px;

}


.form-label {

    display: block;

    color: var(--text);

    margin-bottom: 8px;

    font-size: 13.5px;

    font-weight: 650;

}


.form-label span {

    color: #f87171;

}


.form-input,
.form-select,
.form-textarea {

    width: 100%;

    border: 1px solid var(--border);

    background: #020617;

    color: var(--text);

    border-radius: 9px;

    padding: 12px 13px;

    font-size: 13.5px;

    outline: none;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;

}


.form-input::placeholder,
.form-textarea::placeholder {

    color: #64748b;

}


.form-input:focus,
.form-select:focus,
.form-textarea:focus {

    border-color: var(--primary);

    box-shadow:
        0 0 0 3px rgba(37,99,235,.12);

}


.form-select option {

    background: #0f172a;

    color: #f8fafc;

}


.form-textarea {

    min-height: 155px;

    resize: vertical;

    line-height: 1.65;

}


.field-help {

    color: #64748b;

    font-size: 11.5px;

    line-height: 1.5;

    margin-top: 6px;

}


/* =====================================================
   RATING
===================================================== */

.rating-stars {

    display: flex;

    gap: 7px;

}


.rating-star {

    width: 40px;
    height: 40px;

    border: 1px solid var(--border);

    border-radius: 8px;

    background: #020617;

    color: #475569;

    cursor: pointer;

    font-size: 19px;

    display: flex;

    align-items: center;

    justify-content: center;

    transition:
        background .2s ease,
        color .2s ease,
        border-color .2s ease,
        transform .2s ease;

}


.rating-star:hover {

    transform: translateY(-2px);

    color: #fbbf24;

    border-color: #f59e0b;

    background: rgba(245,158,11,.08);

}


.rating-star.active {

    color: #fbbf24;

    background: rgba(245,158,11,.10);

    border-color: #f59e0b;

}


.rating-text {

    margin-top: 7px;

    color: #64748b;

    font-size: 11.5px;

}


/* =====================================================
   SUBMIT
===================================================== */

.submit-btn {

    width: 100%;

    min-height: 44px;

    border: none;

    border-radius: 9px;

    background: var(--primary);

    color: #fff;

    padding: 12px 16px;

    font-size: 14px;

    font-weight: 650;

    cursor: pointer;

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 9px;

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;

}


.submit-btn:hover {

    background: var(--primary-hover);

    transform: translateY(-1px);

    box-shadow:
        0 6px 18px rgba(37,99,235,.22);

}


.submit-btn:disabled {

    opacity: .6;

    cursor: not-allowed;

    transform: none;

    box-shadow: none;

}


/* =====================================================
   SUCCESS
===================================================== */

.success-message {

    display: none;

    margin-bottom: 20px;

    padding: 13px 14px;

    border-radius: 9px;

    background: rgba(34,197,94,.08);

    border: 1px solid rgba(34,197,94,.18);

    color: #4ade80;

    font-size: 13px;

    line-height: 1.5;

}


.success-message.show {

    display: flex;

    align-items: center;

    gap: 9px;

}


.success-message i {

    font-size: 16px;

}


/* =====================================================
   RIGHT SIDE
===================================================== */

.tips-title {

    color: #93c5fd;

    font-size: 18px;

    font-weight: 650;

    margin-bottom: 14px;

}


.tip-card {

    background: var(--card);

    border: 1px solid var(--border);

    border-radius: 12px;

    padding: 17px;

    margin-bottom: 12px;

    transition:
        background .3s ease,
        border-color .3s ease,
        transform .2s ease,
        box-shadow .2s ease;

}


.tip-card:hover {

    transform: translateY(-2px);

    box-shadow:
        0 8px 22px rgba(0,0,0,.08);

}


.tip-icon {

    width: 38px;
    height: 38px;

    border-radius: 9px;

    background: rgba(37,99,235,.10);

    color: #60a5fa;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 11px;

}


.tip-card h3 {

    color: var(--text);

    font-size: 14px;

    font-weight: 650;

    margin-bottom: 6px;

}


.tip-card p {

    color: var(--muted);

    font-size: 12.5px;

    line-height: 1.6;

}


/* =====================================================
   SUPPORT
===================================================== */

.support-mini-card {

    background: rgba(245,158,11,.05);

    border: 1px solid rgba(245,158,11,.15);

    border-left: 4px solid #f59e0b;

    border-radius: 10px;

    padding: 15px;

    margin-top: 14px;

}


.support-mini-card h3 {

    color: #fbbf24;

    display: flex;

    align-items: center;

    gap: 8px;

    font-size: 14px;

    margin-bottom: 7px;

}


.support-mini-card p {

    color: var(--muted);

    font-size: 12px;

    line-height: 1.6;

}


.support-mini-card a {

    color: #fbbf24;

    font-weight: 650;

    text-decoration: none;

    word-break: break-word;

}


.support-mini-card a:hover {

    text-decoration: underline;

}


/* =====================================================
   LIGHT MODE
===================================================== */

body.light-mode {

    --bg: #f8fafc;

    --sidebar: #ffffff;

    --sidebar-hover: #f1f5f9;

    --card: #ffffff;

    --border: #e2e8f0;

    --text: #0f172a;

    --muted: #475569;

    --shadow: rgba(15,23,42,.08);

}


body.light-mode .sidebar-link {

    color: #475569;

}


body.light-mode .sidebar-link:hover {

    color: #0f172a;

}


body.light-mode .sidebar-link.active {

    background: #eff6ff;

    color: #2563eb;

}


body.light-mode .settings-menu {

    background: #ffffff;

    border-color: #e2e8f0;

    box-shadow:
        0 15px 35px rgba(15,23,42,.12);

}


body.light-mode .settings-item {

    color: #334155;

}


body.light-mode .settings-item:hover {

    background: #f1f5f9;

}


body.light-mode .user-profile {

    background: #f1f5f9;

}


body.light-mode .user-name {

    color: #0f172a;

}


body.light-mode .user-email {

    color: #64748b;

}


body.light-mode .feedback-header h1 {

    color: #0f172a;

}


body.light-mode .feedback-intro {

    background:
        linear-gradient(
            135deg,
            #eff6ff,
            #eef2ff
        );

    border-color: #dbeafe;

}


body.light-mode .feedback-intro h2 {

    color: #2563eb;

}


body.light-mode .feedback-card {

    background: #ffffff;

}


body.light-mode .card-title {

    color: #2563eb;

}


body.light-mode .form-input,
body.light-mode .form-select,
body.light-mode .form-textarea {

    background: #ffffff;

    color: #0f172a;

}


body.light-mode .form-select option {

    background: #ffffff;

    color: #0f172a;

}


body.light-mode .rating-star {

    background: #ffffff;

    color: #cbd5e1;

}


body.light-mode .rating-star.active {

    background: #fffbeb;

}


body.light-mode .tip-card h3 {

    color: #0f172a;

}


body.light-mode .support-mini-card {

    background: #fffbeb;

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 1000px) {

    .feedback-layout {

        grid-template-columns: 1fr;

    }

}


/* =====================================================
   TABLET / SMALL DESKTOP
===================================================== */

@media (max-width: 1200px) {

    .header-ad {

        display: none;

    }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 768px) {

    .sidebar {

        transform: translateX(-100%);

    }


    .sidebar.open,
    .sidebar.active {

        transform: translateX(0);

    }


    .close-sidebar-btn {

        display: flex;

    }


    .mobile-header {

        display: flex;

    }


    .main-content {

        margin-left: 0;

        width: 100%;

        padding:
            82px 16px 30px;

    }


    .feedback-header {

        margin-bottom: 22px;

        padding-bottom: 16px;

    }


    .feedback-header h1 {

        font-size: 19px;

    }


    .feedback-intro {

        padding: 19px;

        border-radius: 12px;

    }


    .feedback-intro h2 {

        font-size: 17px;

        align-items: flex-start;

    }


    .feedback-intro p {

        font-size: 13.5px;

    }


    .feedback-card {

        padding: 18px;

        border-radius: 12px;

        margin-bottom: 14px;

    }


    .card-title {

        font-size: 16px;

        align-items: flex-start;

    }


    .form-input,
    .form-select,
    .form-textarea {

        font-size: 13.5px;

    }


    .tips-title {

        font-size: 16px;

    }

}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media (max-width: 420px) {

    .main-content {

        padding-left: 12px;

        padding-right: 12px;

    }


    .feedback-header h1 {

        font-size: 17px;

    }


    .feedback-intro {

        padding: 16px;

    }


    .feedback-card {

        padding: 15px;

    }


    .feedback-intro h2 {

        font-size: 15px;

    }


    .feedback-intro p {

        font-size: 13px;

    }


    .card-title {

        font-size: 15px;

    }


    .rating-star {

        width: 37px;
        height: 37px;

    }


    .tip-card {

        padding: 15px;

    }

}

</style>

