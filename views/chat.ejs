<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ADA Student Aİ - Söhbət</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome İkonları -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/jpeg" href="/ada-logo.jpeg">

    <!-- Markdown Parser & DOMPurify (XSS Təhlükəsizliyi üçün) -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
    <script src="/js/language.js"></script>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }
html {
    background: 
        radial-gradient(circle at 85% 10%, rgba(34, 211, 238, 0.13), transparent 28%),
        radial-gradient(circle at 50% 80%, rgba(109, 93, 252, 0.18), transparent 50%),
        linear-gradient(135deg, #121928, #0e141f);
    background-attachment: fixed;
    background-color: #0e141f;
    height: 100%;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    overscroll-behavior: none;
}

body {
    background: inherit;
    background-attachment: fixed;
    color: #f8fafc;
    height: 100vh;
    height: 100dvh;
    width: 100%;
    max-width: 100%;
    display: flex;
    overflow: hidden;
    overflow-x: hidden;
    position: relative;
    margin: 0;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    overscroll-behavior: none;
}

    /* Sidebar - Keçmiş Söhbətlər */
    .sidebar {
        width: 320px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, left 0.3s ease;
        z-index: 100;
        height: 100%;
        flex-shrink: 0;
    }

    .sidebar-header {
        padding: 20px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sidebar-header img {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        object-fit: cover;
    }

    .sidebar-header h2 {
        font-size: 17px;
        font-weight: 600;
        color: #ffffff;
    }

    .close-sidebar-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 20px;
        cursor: pointer;
        display: none;
        padding: 4px;
    }

    .new-chat-btn {
        margin: 14px;
        background: rgba(99, 102, 241, 0.15);
        border: 1px solid rgba(99, 102, 241, 0.3);
        color: #818cf8;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.2s;
    }

    .new-chat-btn:hover {
        background: rgba(99, 102, 241, 0.25);
        color: #ffffff;
    }

    .chat-history-list {
        flex: 1;
        overflow-y: auto;
        padding: 0 12px;
    }

    .history-item {
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 13px;
        color: #94a3b8;
        cursor: pointer;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: background 0.2s, color 0.2s;
    }

    .history-item:hover, .history-item.active {
        background: rgba(255, 255, 255, 0.05);
        color: #ffffff;
    }

    .sidebar-footer {
        padding: 14px 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        background: rgba(15, 23, 42, 0.6);
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        overflow: hidden;
        flex: 1;
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.2);
        flex-shrink: 0;
        background: #334155;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #cbd5e1;
        overflow: hidden;
    }

    .user-avatar img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .user-info {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .user-name {
        font-size: 13px;
        font-weight: 600;
        color: #ffffff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-email {
        font-size: 11px;
        color: #94a3b8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        text-decoration: none;
        font-size: 15px;
    }

    .action-btn:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    .register-link-btn {
        width: 100%;
        background: rgba(99, 102, 241, 0.15);
        border: 1px solid rgba(99, 102, 241, 0.3);
        padding: 10px;
        border-radius: 10px;
        color: #818cf8;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: background 0.2s;
    }

    .register-link-btn:hover {
        background: rgba(99, 102, 241, 0.25);
        color: #ffffff;
    }

    /* Chat Main */
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: transparent;
        position: relative;
        height: 100%;
        width: 100%;
        overflow: hidden;
    }

    .chat-header {
        padding: 14px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(30, 41, 59, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .menu-toggle-btn {
        background: transparent;
        border: none;
        color: #cbd5e1;
        font-size: 20px;
        cursor: pointer;
        display: none;
        padding: 4px;
    }

    .chat-header h3 {
        font-size: 16px;
        font-weight: 600;
        color: #e2e8f0;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        scroll-behavior: smooth;
    }

    .message {
        display: flex;
        gap: 12px;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
    }

    .message.user {
        flex-direction: row-reverse;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 14px;
        overflow: hidden;
    }

    .message.user .avatar {
        background: #334155;
        color: #cbd5e1;
    }

    .message.user .avatar img,
    .message.ai .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .message-content {
        background: rgba(30, 41, 59, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: 12px 16px;
        border-radius: 14px;
        font-size: 14px;
        line-height: 1.5;
        color: #e2e8f0;
        max-width: calc(100% - 50px);
        word-break: break-word;
    }

    .message.user .message-content {
        background: #1e293b;
        border-color: rgba(99, 102, 241, 0.2);
    }

    .message-content img.uploaded-img {
        max-width: 240px;
        border-radius: 8px;
        margin-top: 8px;
        display: block;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .message-content pre {
        background: #090d16;
        padding: 12px;
        border-radius: 8px;
        overflow-x: auto;
        margin: 8px 0;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .message-content code {
        font-family: monospace;
        background: rgba(255, 255, 255, 0.08);
        padding: 2px 5px;
        border-radius: 4px;
        font-size: 13px;
    }

    .message-content pre code {
        background: transparent;
        padding: 0;
    }

    /* Input Container & Buttons */
    .chat-input-container {
        padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)) 16px;
        background: linear-gradient(to top, rgba(14, 20, 31, 0.95) 70%, transparent 100%);
    }

    .premium-select-wrapper {
        max-width: 900px;
        margin: 0 auto 8px auto;
        display: flex;
        justify-content: flex-start;
        gap: 8px;
        flex-wrap: wrap;
    }

    .premium-lesson-btn, .ada-pro-btn {
        padding: 8px 14px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .premium-lesson-btn {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(168, 85, 247, 0.2));
        border: 1px solid rgba(99, 102, 241, 0.4);
        color: #c7d2fe;
    }

    .premium-lesson-btn:hover, .premium-lesson-btn.active-glow {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.4), rgba(168, 85, 247, 0.4));
        color: #ffffff;
        border-color: #818cf8;
    }

    .premium-lesson-btn.active-glow {
        box-shadow: 0 0 15px rgba(99, 102, 241, 0.6);
    }

    .ada-pro-btn {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(239, 68, 68, 0.2));
        border: 1px solid rgba(245, 158, 11, 0.4);
        color: #fde68a;
    }

    .ada-pro-btn:hover, .ada-pro-btn.active-glow {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.4), rgba(239, 68, 68, 0.4));
        color: #ffffff;
        border-color: #fbbf24;
    }

    .ada-pro-btn.active-glow {
        box-shadow: 0 0 15px rgba(245, 158, 11, 0.6);
    }

    .chat-input-wrapper {
        max-width: 900px;
        margin: 0 auto;
        background: rgba(30, 41, 59, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        padding: 8px 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        transition: border-color 0.3s;
    }

    .chat-input-wrapper:focus-within {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
    }

    .file-preview-container {
        display: none;
        align-items: center;
        gap: 10px;
        background: rgba(15, 23, 42, 0.6);
        padding: 8px 12px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .file-preview-container.active {
        display: flex;
    }

    .file-preview-container img {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 6px;
    }

    .file-icon-placeholder {
        width: 44px;
        height: 44px;
        background: #1e293b;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #818cf8;
        font-size: 18px;
    }

    .file-info {
        font-size: 12px;
        color: #cbd5e1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
    }

    .remove-file-btn {
        background: transparent;
        border: none;
        color: #ef4444;
        cursor: pointer;
        font-size: 14px;
        padding: 4px;
    }

    .input-main-row {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
    }

    .chat-input-wrapper textarea {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #ffffff;
        font-size: 14px;
        resize: none;
        max-height: 120px;
        min-height: 24px;
        line-height: 1.4;
    }

    .chat-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .input-action-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        font-size: 15px;
    }

    .input-action-btn:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    .input-action-btn.listening {
        color: #ef4444;
        animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.15); }
        100% { transform: scale(1); }
    }

    .send-btn {
        background: #6366f1;
        color: white;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
        font-size: 15px;
    }

    .send-btn:hover {
        background: #4f46e5;
    }

    .mic-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .lang-dropdown {
        position: absolute;
        bottom: 125%;
        left: 50%;
        transform: translateX(-50%) scale(0.9);
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 10px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4);
        display: none;
        flex-direction: column;
        padding: 4px;
        gap: 3px;
        z-index: 1000;
        opacity: 0;
        transition: all 0.2s ease;
    }

    .lang-dropdown.show {
        display: flex;
        opacity: 1;
        transform: translateX(-50%) scale(1);
    }

    .lang-option {
        background: transparent;
        border: none;
        color: #f8fafc;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 600;
        text-align: center;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
    }

    .lang-option:hover, .lang-option.active-lang {
        background: #3b82f6;
        color: #fff;
    }

    .sidebar-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        
        z-index: 99;
        display: none;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    /* Mobil uyğunluq (Responsive) */
    @media (max-width: 768px) {
        .sidebar {
            position: fixed;
            top: 0;
            left: -320px;
            height: 100%;
        }

        .sidebar.open {
            left: 0;
        }

        .close-sidebar-btn, .menu-toggle-btn {
            display: block;
        }

        .sidebar-overlay.active {
            display: block;
            opacity: 1;
        }

        .chat-messages {
            padding: 12px;
        }
    }
    .disclaimer {
    text-align: center;
    font-size: 8px;
    color: #64748b;
    padding: 6px 12px;
    margin-top: 6px;
    line-height: 1.35;
    letter-spacing: 0.1px;
    user-select: none;
}

.chat-input-wrapper textarea {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #ffffff;
        font-size: 16px; /* 14px yerinə 16px edildi ki, iOS avtomatik zoom etməsin */
        resize: none;
        max-height: 120px;
        min-height: 24px;
        line-height: 1.4;
    }

    .chat-container {
    height: 100dvh; /* köhnə 100vh yerinə */
    display: flex;
    flex-direction: column;
}


/* Sidebar Footer və Ayarlar Menyusu Üslubları */
.sidebar-footer {
    position: relative;
    padding: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.settings-dropdown-container {
    position: relative;
    width: 100%;
}

.settings-toggle-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    background: transparent;
    border: none;
    color: #cbd5e1;
    padding: 10px 12px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    transition: background 0.2s, color 0.2s;
}

.settings-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}

/* Açılır menyu paneli (şəkildəki kimi tünd fon və küncləri oval) */
.settings-menu {
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 240px;
    background: #1e1e2f;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    display: none; /* JavaScript ilə 'display: block' ediləcək */
    flex-direction: column;
    padding: 8px 0;
    margin-bottom: 8px;
    z-index: 1000;
}

.settings-menu.active {
    display: flex;
}

.settings-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 13px;
    transition: background 0.2s, color 0.2s;
}

.settings-item:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

.settings-item i {
    width: 16px;
    text-align: center;
    color: #94a3b8;
}

.settings-item:hover i {
    color: #ffffff;
}

* {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    /* Standart Qaranlıq Mod (Dark Mode) Dəyişənləri */
    :root {
        --bg-html-1: #121928;
        --bg-html-2: #0e141f;
        --bg-sidebar: rgba(15, 23, 42, 0.85);
        --bg-sidebar-footer: rgba(15, 23, 42, 0.6);
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --border-color: rgba(255, 255, 255, 0.08);
        --chat-header-bg: rgba(30, 41, 59, 0.4);
        --message-ai-bg: rgba(30, 41, 59, 0.6);
        --message-user-bg: #1e293b;
        --input-wrapper-bg: rgba(30, 41, 59, 0.9);
        --settings-menu-bg: #1e1e2f;
        --settings-item-hover: rgba(255, 255, 255, 0.08);
    }

    /* Açıq Mod (Light Mode) Dəyişənləri */
    body.light-mode {
        --bg-html-1: #f1f5f9;
        --bg-html-2: #e2e8f0;
        --bg-sidebar: rgba(255, 255, 255, 0.9);
        --bg-sidebar-footer: rgba(241, 245, 249, 0.8);
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: rgba(0, 0, 0, 0.08);
        --chat-header-bg: rgba(255, 255, 255, 0.7);
        --message-ai-bg: rgba(241, 245, 249, 0.9);
        --message-user-bg: #e2e8f0;
        --input-wrapper-bg: rgba(255, 255, 255, 0.95);
        --settings-menu-bg: #ffffff;
        --settings-item-hover: rgba(0, 0, 0, 0.05);
    }

    html {
        background: 
            radial-gradient(circle at 85% 10%, rgba(34, 211, 238, 0.13), transparent 28%),
            radial-gradient(circle at 50% 80%, rgba(109, 93, 252, 0.18), transparent 50%),
            linear-gradient(135deg, var(--bg-html-1), var(--bg-html-2));
        background-attachment: fixed;
        background-color: var(--bg-html-2);
        height: 100%;
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        overscroll-behavior: none;
    }

    body {
        background: inherit;
        background-attachment: fixed;
        color: var(--text-main);
        height: 100vh;
        height: 100dvh;
        width: 100%;
        max-width: 100%;
        display: flex;
        overflow: hidden;
        overflow-x: hidden;
        position: relative;
        margin: 0;
        padding-top: env(safe-area-inset-top, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
        overscroll-behavior: none;
    }

    /* Sidebar */
    .sidebar {
        width: 320px;
        background: var(--bg-sidebar);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, left 0.3s ease;
        z-index: 100;
        height: 100%;
        flex-shrink: 0;
    }

    .sidebar-header {
        padding: 20px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
