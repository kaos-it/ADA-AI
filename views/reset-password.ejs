<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şifrəni bərpa et | Ada AI</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome İkonları -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="icon" type="image/jpeg" href="/ada-logo.jpeg">
     <script src="/js/language.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

html {
            background-color: #0e141f; /* Brauzer elastik sürükləndikdə (bounce effect) ağ boşluq görünməsin */
            height: 100%;
            overflow-x: hidden;
        }

        body {
            width: 100%;
            min-height: 100vh;
            min-height: 100dvh; /* Mobil brauzerlərin dinamik ekran hündürlüyü üçün */
            background: 
                radial-gradient(circle at 85% 10%, rgba(34, 211, 238, 0.13), transparent 28%),
                radial-gradient(circle at 50% 80%, rgba(109, 93, 252, 0.18), transparent 50%),
                linear-gradient(135deg, #121928, #0e141f);
            background-attachment: fixed;
            background-size: cover;
            background-color: #0e141f;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
            color: #f8fafc;
            padding: 16px;
            /* Mobil cihazların təhlükəsiz zonalarını (notches) nəzərə almaq üçün: */
            padding-top: max(16px, env(safe-area-inset-top));
            padding-bottom: max(16px, env(safe-area-inset-bottom));
        }

        .background-blobs .blob {
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            opacity: 0.4;
        }

        .blob-1 {
            top: -100px;
            left: -100px;
            background: #6366f1;
        }

        .blob-2 {
            bottom: -100px;
            right: -100px;
            background: #3b82f6;
        }

        .register-container {
            width: 100%;
            max-width: 440px;
            padding: 0;
            z-index: 1;
        }

        .register-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 32px 28px;
            border-radius: 24px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
        }

        .brand-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .logo-icon {
            width: 85px; 
            height: 85px;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px auto;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3);
        }

        .logo-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .brand-header h1 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 6px;
            color: #ffffff;
        }

        .brand-header p {
            font-size: 13px;
            color: #94a3b8;
            line-height: 1.4;
        }

        .error-alert {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 13px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .success-alert {
            background: rgba(34, 197, 94, 0.15);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: #86efac;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 13px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .input-group {
            margin-bottom: 16px;
        }

        .input-group label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 6px;
            color: #cbd5e1;
        }

        .input-field {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-field i {
            position: absolute;
            left: 16px;
            color: #64748b;
            font-size: 16px;
        }

        .input-field input {
            width: 100%;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 12px 16px 12px 46px;
            border-radius: 12px;
            color: #ffffff;
            font-size: 14px;
            outline: none;
            transition: all 0.3s ease;
        }

        .input-field input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
        }

        .submit-btn {
            width: 100%;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
            margin-top: 6px;
        }

        .submit-btn:hover {
            background: linear-gradient(135deg, #4f46e5, #4338ca);
            box-shadow: 0 6px 16px rgba(99, 102, 241, 0.6);
            transform: translateY(-1px);
        }

        .login-redirect {
            text-align: center;
            margin-top: 18px;
            font-size: 14px;
            color: #94a3b8;
        }

        .login-redirect a {
            color: #818cf8;
            text-decoration: none;
            font-weight: 500;
        }

        .login-redirect a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="background-blobs">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
    </div>

    <div class="register-container">
        <div class="register-card">
            <div class="brand-header">
                <div class="logo-icon">
                    <img src="/ada-logo.jpeg" alt="Logo">
                </div>
                <h1>Şifrəni bərpa et</h1>
                <p>E-poçt ünvanınızı daxil edin, şifrənizi sıfırlamaq üçün sizə təlimat göndərək.</p>
            </div>

            <!-- Serverdən xəta gələrsə göstəriləcək blok -->
            <% if (locals.errorMessage) { %>
                <div class="error-alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span><%= errorMessage %></span>
                </div>
            <% } %>

            <!-- Serverdən uğur mesajı gələrsə göstəriləcək blok -->
            <% if (locals.successMessage || locals.message) { %>
                <div class="success-alert">
                    <i class="fa-solid fa-circle-check"></i>
                    <span><%= locals.successMessage || locals.message %></span>
                </div>
            <% } %>

            <!-- Parolu bərpa forması -->
            <form action="/reset-password" method="POST">
                <div class="input-group">
                    <label for="email">E-poçt ünvanı</label>
                    <div class="input-field">
                        <i class="fa-regular fa-envelope"></i>
                        <input type="email" id="email" name="email" placeholder="ornek@mail.com" required>
                    </div>
                </div>

                <button type="submit" class="submit-btn">
                    <span>Sıfırlama linki göndər</span>
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>

            <div class="login-redirect">
                Şifrənizi xatırladınız? <a href="/login">Giriş səhifəsinə qayıt</a>
            </div>
        </div>
    </div>

</body>
</html>