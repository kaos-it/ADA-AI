let isRecording = false;


/* =========================================================
   TEXT TO SPEECH VARIABLES
   ========================================================= */

let speechVoices = [];

let activeSpeechButton = null;

let activeUtterance = null;


/* =========================================================
   DEFAULT MESSAGE
   ========================================================= */

const defaultWelcomeMsg = {

    text:
        "Salam! Mən ADA Student Aİ köməkçisiyəm. " +
        "ADA Group tərəfindən dərslərinizə dəstək olmaq üçün yaradılmışam. " +
        "Dərslərinizin fotosunu və ya səsli mesajınızı mənə ataraq " +
        "ətraflı izahını ala bilərsiniz!",

    sender: "ai"
};


/* =========================================================
   LANGUAGE OPTIONS
   ========================================================= */

/*
   Vacib:
   Əvvəlki kodda document.querySelectorAll('.lang-option')
   həm sidebar dil seçimlərini, həm də mikrofon dil seçimlərini
   götürə bilərdi.

   İndi yalnız mic üçün olan menyunu götürürük.
*/

const speechLangOptions =
    document.querySelectorAll('#langDropdown .lang-option');


function updateSelectedSpeechLanguageUI() {

    speechLangOptions.forEach(opt => {

        const lang =
            opt.getAttribute('data-lang');

        if (lang === selectedSpeechLang) {

            opt.classList.add('active-lang');

            if (changeLangBtn) {
                changeLangBtn.textContent =
                    opt.textContent.trim();
            }

        } else {

            opt.classList.remove('active-lang');

        }

    });

}


/* =========================================================
   SPEECH LANGUAGE SELECT
   ========================================================= */

speechLangOptions.forEach(opt => {

    opt.addEventListener('click', (e) => {

        e.preventDefault();
        e.stopPropagation();

        speechLangOptions.forEach(o => {
            o.classList.remove('active-lang');
        });

        opt.classList.add('active-lang');

        selectedSpeechLang =
            opt.getAttribute('data-lang') || 'az-AZ';

        localStorage.setItem(
            'ada_speech_lang',
            selectedSpeechLang
        );

        if (recognition) {

            recognition.lang =
                selectedSpeechLang;

        }

        if (changeLangBtn) {

            changeLangBtn.textContent =
                opt.textContent.trim();

        }

        if (langDropdown) {

            langDropdown.classList.remove('show');

        }

    });

});


/* =========================================================
   LANGUAGE DROPDOWN
   ========================================================= */

if (changeLangBtn) {

    changeLangBtn.addEventListener('click', (e) => {

        e.preventDefault();
        e.stopPropagation();

        if (langDropdown) {

            langDropdown.classList.toggle('show');

        }

    });

}


document.addEventListener('click', (e) => {

    if (
        micWrapper &&
        !micWrapper.contains(e.target)
    ) {

        if (langDropdown) {

            langDropdown.classList.remove('show');

        }

    }

});


updateSelectedSpeechLanguageUI();


/* =========================================================
   LOCAL STORAGE
   ========================================================= */

function getStoredChats() {

    try {

        return JSON.parse(
            localStorage.getItem(STORAGE_KEY)
        ) || {};

    } catch (e) {

        console.error(
            "LocalStorage oxuma xətası:",
            e
        );

        return {};

    }

}


function saveStoredChats(chats) {

    try {

        localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(chats)
        );

    } catch (e) {

        console.error(
            "LocalStorage dolub:",
            e
        );

    }

}


/* =========================================================
   INIT APP
   ========================================================= */

function initApp() {

    const chats =
        getStoredChats();

    let savedCurrentId =
        localStorage.getItem(
            CURRENT_CHAT_KEY
        );


    if (
        !savedCurrentId ||
        !chats[savedCurrentId]
    ) {

        savedCurrentId =
            createNewChat(false);

    } else {

        currentChatId =
            savedCurrentId;

    }


    renderSidebarHistory();

    loadChat(currentChatId);

}


/* =========================================================
   CREATE NEW CHAT
   ========================================================= */

function createNewChat(
    shouldRender = true
) {

    const chats =
        getStoredChats();

    const newId =
        'chat_' + Date.now();


    chats[newId] = {

        id: newId,

        title: "Yeni Söhbət",

        messages: [
            defaultWelcomeMsg
        ]

    };


    saveStoredChats(chats);

    currentChatId =
        newId;


    localStorage.setItem(
        CURRENT_CHAT_KEY,
        currentChatId
    );


    if (shouldRender) {

        renderSidebarHistory();

        loadChat(currentChatId);

    }


    return newId;

}


/* =========================================================
   LOAD CHAT
   ========================================================= */

function loadChat(chatId) {

    currentChatId =
        chatId;

    localStorage.setItem(
        CURRENT_CHAT_KEY,
        currentChatId
    );


    chatMessages.innerHTML = '';


    const chats =
        getStoredChats();

    const chat =
        chats[chatId];


    if (
        chat &&
        chat.messages
    ) {

        chat.messages.forEach(msg => {

            appendMessageUI(
                msg.text,
                msg.sender,
                msg.isHtml || false,
                msg.fileBase64
            );

        });

    }


    renderSidebarHistory();

}


/* =========================================================
   SAVE MESSAGE
   ========================================================= */

function saveMessageToCurrentChat(
    text,
    sender,
    isHtml = false,
    fileBase64 = null
) {

    const chats =
        getStoredChats();


    if (!chats[currentChatId]) {

        chats[currentChatId] = {

            id: currentChatId,

            title: "Yeni Söhbət",

            messages: []

        };

    }


    chats[currentChatId].messages.push({

        text,
        sender,
        isHtml,
        fileBase64

    });


    if (
        sender === 'user' &&
        chats[currentChatId].title === "Yeni Söhbət"
    ) {

        const plainText =
            text
                .replace(/<[^>]*>?/gm, '')
                .trim();


        chats[currentChatId].title =
            plainText.length > 25
                ? plainText.substring(0, 25) + '...'
                : (plainText || "Fayl/Şəkil");

    }


    saveStoredChats(chats);

    renderSidebarHistory();

}


/* =========================================================
   SIDEBAR HISTORY
   ========================================================= */

function renderSidebarHistory() {

    const chats =
        getStoredChats();


    chatHistoryList.innerHTML = '';


    const chatKeys =
        Object.keys(chats).reverse();


    if (chatKeys.length === 0) {

        chatHistoryList.innerHTML = `
            <div
                style="
                    padding:15px;
                    font-size:13px;
                    color:#94a3b8;
                    text-align:center;
                "
            >
                Hələ heç bir söhbət yoxdur
            </div>
        `;

        return;

    }


    chatKeys.forEach(key => {

        const chat =
            chats[key];


        const item =
            document.createElement('div');


        item.classList.add(
            'history-item'
        );


        if (key === currentChatId) {

            item.classList.add(
                'active'
            );

        }


        item.textContent =
            chat.title || "Yeni Söhbət";


        item.addEventListener(
            'click',
            () => {

                loadChat(key);

                if (
                    window.innerWidth <= 768
                ) {

                    toggleSidebar();

                }

            }
        );


        chatHistoryList.appendChild(item);

    });

}


/* =========================================================
   NEW CHAT
   ========================================================= */

if (newChatBtn) {

    newChatBtn.addEventListener(
        'click',
        () => {

            createNewChat(true);

            if (
                window.innerWidth <= 768
            ) {

                toggleSidebar();

            }

        }
    );

}


