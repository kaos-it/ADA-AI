<!DOCTYPE html>
<html lang="az">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Yardım - ADA Student AI</title>


    <!-- =====================================================
         FONT AWESOME
    ====================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >


    <!-- =====================================================
         MARKDOWN + DOMPURIFY
    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>


    <!-- =====================================================
         LANGUAGE
    ====================================================== -->

    <script src="/js/language.js"></script>


    <!-- =====================================================
         FAVICON
    ====================================================== -->

    <link
        rel="icon"
        type="image/jpeg"
        href="/ada-logo.jpeg"
    >


<style>

/* =====================================================
   ROOT
===================================================== */

:root {

    --bg: #020617;

    --sidebar: #0f172a;

    --sidebar-hover: #1e293b;

    --card: #0f172a;

    --border: #1e293b;

    --text: #f8fafc;

    --muted: #94a3b8;

    --primary: #2563eb;

    --primary-hover: #1d4ed8;

    --blue: #60a5fa;

    --shadow: rgba(0,0,0,.25);

}


/* =====================================================
   RESET
===================================================== */

* {

    box-sizing: border-box;

    margin: 0;

    padding: 0;

    font-family:
        'Segoe UI',
        Tahoma,
        Geneva,
        Verdana,
        sans-serif;

}


html {

    scroll-behavior: smooth;

    overflow-x: hidden;

}


body {

    background: var(--bg);

    color: var(--text);

    min-height: 100vh;

    overflow-x: hidden;

    transition:
        background-color .3s ease,
        color .3s ease;

}


/* =====================================================
   SIDEBAR
===================================================== */

.sidebar {

    position: fixed;

    top: 0;
    left: 0;

    width: 280px;

    height: 100vh;

    background: var(--sidebar);

    color: var(--text);

    display: flex;

    flex-direction: column;

    z-index: 1000;

    border-right:
        1px solid var(--border);

    transition:
        transform .3s ease,
        background-color .3s ease,
        border-color .3s ease;

}


/* =====================================================
   SIDEBAR HEADER
===================================================== */

.sidebar-header {

    height: 72px;

    padding: 0 17px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    border-bottom:
        1px solid var(--border);

    flex-shrink: 0;

}


.logo-area {

    display: flex;

    align-items: center;

    gap: 11px;

    min-width: 0;

}


.sidebar-logo {

    width: 36px;

    height: 36px;

    border-radius: 50%;

    object-fit: cover;

    flex-shrink: 0;

}


.sidebar-title {

    font-size: 16px;

    font-weight: 700;

    letter-spacing: -.4px;

    white-space: nowrap;

}


.close-sidebar-btn {

    width: 34px;

    height: 34px;

    border: none;

    background: transparent;

    color: #94a3b8;

    border-radius: 8px;

    cursor: pointer;

    font-size: 18px;

    display: none;

    align-items: center;

    justify-content: center;

}


.close-sidebar-btn:hover {

    background: var(--sidebar-hover);

    color: #fff;

}


/* =====================================================
   CHAT BUTTON
===================================================== */

.sidebar-action-area {

    padding: 16px;

}


.new-chat-btn {

    width: 100%;

    min-height: 44px;

    border: none;

    border-radius: 9px;

    background: var(--primary);

    color: #fff;

    text-decoration: none;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    font-size: 14px;

    font-weight: 600;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;

}


.new-chat-btn:hover {

    background: var(--primary-hover);

    transform: translateY(-1px);

    box-shadow:
        0 6px 18px rgba(37,99,235,.22);

}


/* =====================================================
   SIDEBAR CONTENT
===================================================== */

.sidebar-content {

    flex: 1;

    overflow-y: auto;

    padding: 0 12px 15px;

}


.sidebar-content::-webkit-scrollbar {

    width: 5px;

}


.sidebar-content::-webkit-scrollbar-track {

    background: transparent;

}


.sidebar-content::-webkit-scrollbar-thumb {

    background: #334155;

    border-radius: 20px;

}


/* =====================================================
   QUICK MENU
===================================================== */

.sidebar-section-title {

    color: #64748b;

    font-size: 11px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .8px;

    padding: 10px 10px 7px;

}


.sidebar-link {

    width: 100%;

    padding: 10px 11px;

    display: flex;

    align-items: center;

    gap: 11px;

    color: #cbd5e1;

    background: transparent;

    border: none;

    border-radius: 8px;

    text-decoration: none;

    font-size: 13.5px;

    margin-bottom: 3px;

    transition:
        background .2s ease,
        color .2s ease;

}


.sidebar-link i {

    width: 19px;

    text-align: center;

    font-size: 14px;

}


.sidebar-link:hover {

    background: var(--sidebar-hover);

    color: #fff;

}


.sidebar-link.active {

    background:
        rgba(37,99,235,.14);

    color: #60a5fa;

}


/* =====================================================
   SIDEBAR FOOTER
===================================================== */

.sidebar-footer {

    padding: 14px 15px 15px;

    border-top:
        1px solid var(--border);

    background: var(--sidebar);

    flex-shrink: 0;

}


/* =====================================================
   SETTINGS
===================================================== */

.settings-dropdown-wrapper {

    position: relative;

}


.settings-toggle-btn {

    width: 100%;

    min-height: 42px;

    border: none;

    background: transparent;

    color: #cbd5e1;

    border-radius: 8px;

    padding: 10px 11px;

    display: flex;

    align-items: center;

    gap: 10px;

    font-size: 13.5px;

    cursor: pointer;

}


.settings-toggle-btn:hover,
.settings-toggle-btn.active {

    background: var(--sidebar-hover);

    color: #fff;

}


.settings-toggle-btn .arrow {

    margin-left: auto;

    font-size: 11px;

    transition:
        transform .2s ease;

}


.settings-toggle-btn.active .arrow {

    transform: rotate(180deg);

}


/* =====================================================
   SETTINGS MENU
===================================================== */

.settings-menu {

    position: absolute;

    left: 0;

    bottom: calc(100% + 8px);

    width: 100%;

    padding: 5px;

    background: #1e293b;

    border:
        1px solid #334155;

    border-radius: 10px;

    box-shadow:
        0 15px 35px rgba(0,0,0,.3);

    display: none;

    z-index: 50;

}


.settings-menu.active {

    display: block;

}


.settings-item {

    width: 100%;

    padding: 11px 12px;

    display: flex;

    align-items: center;

    gap: 10px;

    border-radius: 7px;

    color: #f8fafc;

    text-decoration: none;

    font-size: 13px;

    background: transparent;

    border: none;

    cursor: pointer;

    text-align: left;

}


.settings-item i {

    width: 18px;

    text-align: center;

}


.settings-item:hover {

    background: #334155;

}


/* =====================================================
   USER PROFILE
===================================================== */

.user-profile {

    margin-top: 9px;

    min-height: 55px;

    padding: 8px;

    display: flex;

    align-items: center;

    gap: 9px;

    border-radius: 9px;

    background:
        rgba(0,0,0,.18);

    min-width: 0;

}


.user-avatar {

    width: 38px;

    height: 38px;

    border-radius: 50%;

    overflow: hidden;

    background: #334155;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #cbd5e1;

    flex-shrink: 0;

}


.user-avatar img {

    width: 100%;

    height: 100%;

    object-fit: cover;

}


.user-info {

    flex: 1;

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.user-name {

    color: #f8fafc;

    font-size: 13px;

    font-weight: 650;

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.user-email {

    color: #94a3b8;

    font-size: 10.5px;

    margin-top: 2px;

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.logout-btn {

    width: 32px;

    height: 32px;

    border-radius: 7px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #94a3b8;

    text-decoration: none;

    flex-shrink: 0;

}


.logout-btn:hover {

    background:
        rgba(239,68,68,.12);

    color: #ef4444;

}


/* =====================================================
   LOGIN
===================================================== */

.login-btn {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    width: 100%;

    padding: 11px;

    border-radius: 8px;

    background:
        rgba(34,197,94,.10);

    border:
        1px solid rgba(34,197,94,.20);

    color: #4ade80;

    text-decoration: none;

    font-size: 13px;

    font-weight: 600;

}


/* =====================================================
   OVERLAY
===================================================== */

.sidebar-overlay {

    position: fixed;

    inset: 0;

    background:
        rgba(0,0,0,.55);

    backdrop-filter: blur(2px);

    z-index: 999;

    display: none;

}


.sidebar-overlay.active {

    display: block;

}


/* =====================================================
   MAIN CONTENT
===================================================== */

.main-content {

    margin-left: 280px;

    width:
        calc(100% - 280px);

    min-height: 100vh;

    padding: 40px;

}


/* =====================================================
   TOP AD
===================================================== */

.help-top-ad {

    max-width: 1000px;

    min-height: 90px;

    height: 90px;

    margin:
        0 auto 25px;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;

    position: relative;

    z-index: 1;

}


/*
   Reklam iframe-i böyükdür.
   Container onu mərkəzdə saxlayır.
*/

.help-top-ad iframe {

    max-width: 100% !important;

}


/* =====================================================
   HEADER
===================================================== */

.help-header {

    max-width: 1000px;

    margin:
        0 auto 30px;

    padding-bottom: 20px;

    border-bottom:
        1px solid var(--border);

    display: flex;

    align-items: center;

}


.help-header h1 {

    display: flex;

    align-items: center;

    gap: 12px;

    font-size: 25px;

    font-weight: 650;

    color: var(--text);

}


.help-header h1 i {

    color: var(--blue);

}


/* =====================================================
   CONTENT
===================================================== */

.help-container {

    max-width: 1000px;

    margin: 0 auto;

}


.help-content-layout {

    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        300px;

    gap: 25px;

    align-items: start;

}


/* =====================================================
   RIGHT AD
===================================================== */

.help-side-ad {

    width: 300px;

    min-width: 300px;

    height: 250px;

    min-height: 250px;

    display: flex;

    justify-content: center;

    align-items: flex-start;

    position: sticky;

    top: 30px;

    overflow: hidden;

    z-index: 1;

}


/* =====================================================
   HELP CARD
===================================================== */

.help-card {

    background: var(--card);

    border:
        1px solid var(--border);

    border-radius: 14px;

    padding: 24px;

    margin-bottom: 18px;

    transition:
        background .3s ease,
        border-color .3s ease,
        box-shadow .3s ease;

}


.help-card:hover {

    box-shadow:
        0 8px 25px rgba(0,0,0,.08);

}


.help-card h3 {

    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 12px;

    color: #93c5fd;

    font-size: 18px;

    font-weight: 650;

}


.help-card h3 i {

    width: 22px;

    text-align: center;

}


.help-card p,
.help-card li {

    color: var(--muted);

    font-size: 14.5px;

    line-height: 1.7;

    word-break: break-word;

}


.help-card ul {

    padding-left: 22px;

    margin-top: 10px;

}


.help-card li {

    margin-bottom: 7px;

}


.help-card a {

    color: #f59e0b;

    font-weight: 700;

    text-decoration: underline;

}


/* =====================================================
   SUPPORT CARD
===================================================== */

.support-card {

    background:
        rgba(245,158,11,.05);

    border:
        1px solid rgba(245,158,11,.15);

    border-left:
        4px solid #f59e0b;

}


.support-card h3 {

    color: #fbbf24;

}


/* =====================================================
   BOTTOM AD
===================================================== */

.help-bottom-ad {

    max-width: 1000px;

    min-height: 90px;

    height: 90px;

    margin:
        30px auto 0;

    display: flex;

    justify-content: center;

    align-items: center;

    overflow: hidden;

}


/* =====================================================
   MOBILE HEADER
===================================================== */

.mobile-header {

    display: none;

    position: fixed;

    top: 0;
    left: 0;
    right: 0;

    height: 60px;

    z-index: 1001;

    padding: 0 15px;

    background: var(--sidebar);

    border-bottom:
        1px solid var(--border);

    align-items: center;

}


.mobile-menu-btn {

    width: 38px;

    height: 38px;

    border: none;

    border-radius: 8px;

    background: transparent;

    color: var(--text);

    font-size: 20px;

    cursor: pointer;

}


.mobile-brand {

    display: flex;

    align-items: center;

    gap: 9px;

    margin-left: 8px;

    font-weight: 700;

    font-size: 15px;

    color: var(--text);

}


.mobile-brand img {

    width: 31px;

    height: 31px;

    border-radius: 50%;

    object-fit: cover;

}


/* =====================================================
   LIGHT MODE
===================================================== */

body.light-mode {

    --bg: #f8fafc;

    --sidebar: #ffffff;

    --sidebar-hover: #f1f5f9;

    --card: #ffffff;

    --border: #e2e8f0;

    --text: #0f172a;

    --muted: #475569;

}


body.light-mode .sidebar-link {

    color: #475569;

}


body.light-mode .sidebar-link:hover {

    color: #0f172a;

}


body.light-mode .sidebar-link.active {

    background: #eff6ff;

    color: #2563eb;

}


body.light-mode .settings-menu {

    background: #ffffff;

    border-color: #e2e8f0;

    box-shadow:
        0 15px 35px
        rgba(15,23,42,.12);

}


body.light-mode .settings-item {

    color: #334155;

}


body.light-mode .settings-item:hover {

    background: #f1f5f9;

}


body.light-mode .user-profile {

    background: #f1f5f9;

}


body.light-mode .user-name {

    color: #0f172a;

}


body.light-mode .user-email {

    color: #64748b;

}


body.light-mode .help-header h1 {

    color: #0f172a;

}


body.light-mode .help-card h3 {

    color: #2563eb;

}


body.light-mode .support-card h3 {

    color: #d97706;

}


body.light-mode .support-card {

    background: #fffbeb;

}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 1150px) {

    .help-content-layout {

        grid-template-columns: 1fr;

    }

    .help-side-ad {

        display: none;

    }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 768px) {

    /* ===============================
       SIDEBAR
    =============================== */

    .sidebar {

        transform:
            translateX(-100%);

    }


    .sidebar.open,
    .sidebar.active {

        transform:
            translateX(0);

    }


    .close-sidebar-btn {

        display: flex;

    }


    .mobile-header {

        display: flex;

    }


    /* ===============================
       MAIN
    =============================== */

    .main-content {

        margin-left: 0;

        width: 100%;

        padding:
            76px 14px 30px;

    }


    /* ===============================
       MOBILE TOP AD
    =============================== */

    /*
       Mobilde yalnız TOP reklam qalır.
       Bu səhifədə istifadəçiyə yalnız
       1 reklam göstərilir.
    */

    .help-top-ad {

        display: flex;

        width: 100%;

        max-width: 100%;

        height: 90px;

        min-height: 90px;

        margin:
            0 auto 20px;

        overflow: hidden;

    }


    .help-top-ad iframe {

        width: 100% !important;

        max-width: 100% !important;

    }


    /* ===============================
       SAĞ REKLAM MOBİLDE YOXDUR
    =============================== */

    .help-side-ad {

        display: none !important;

    }


    /* ===============================
       AŞAĞI REKLAM MOBİLDE YOXDUR
    =============================== */

    .help-bottom-ad {

        display: none !important;

    }


    /* ===============================
       HEADER
    =============================== */

    .help-header {

        margin:
            0 auto 22px;

        padding-bottom: 16px;

    }


    .help-header h1 {

        font-size: 19px;

        gap: 9px;

    }


    /* ===============================
       CONTENT
    =============================== */

    .help-content-layout {

        display: block;

    }


    .help-main-content {

        width: 100%;

    }


    /* ===============================
       CARDS
    =============================== */

    .help-card {

        padding: 18px;

        border-radius: 12px;

        margin-bottom: 14px;

    }


    .help-card h3 {

        font-size: 16px;

        align-items: flex-start;

    }


    .help-card p,
    .help-card li {

        font-size: 14px;

        line-height: 1.65;

    }

}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media (max-width: 420px) {

    .main-content {

        padding-left: 12px;

        padding-right: 12px;

    }


    .help-top-ad {

        margin-bottom: 18px;

    }


    .help-header h1 {

        font-size: 17px;

    }


    .help-card {

        padding: 15px;

    }


    .help-card h3 {

        font-size: 15px;

    }


    .help-card p,
    .help-card li {

        font-size: 13.5px;

    }

}

</style>

</head>


<body>


<!-- =========================================================
     MOBILE HEADER
========================================================= -->

<header class="mobile-header">

    <button
        class="mobile-menu-btn"
        id="menuToggleBtn"
        aria-label="Menyunu aç"
    >

        <i class="fa-solid fa-bars"></i>

    </button>


    <div class="mobile-brand">

        <img
            src="/ada-logo.jpeg"
            alt="ADA Logo"
        >

        <span>
            ADA Student AI
        </span>

    </div>

</header>


<!-- =========================================================
     SIDEBAR OVERLAY
========================================================= -->

<div
    class="sidebar-overlay"
    id="sidebarOverlay"
></div>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside
    class="sidebar"
    id="sidebar"
>


    <div class="sidebar-header">

        <div class="logo-area">

            <img
                src="/ada-logo.jpeg"
                alt="ADA Logo"
                class="sidebar-logo"
            >

            <span class="sidebar-title">
                ADA Student AI
            </span>

        </div>


        <button
            class="close-sidebar-btn"
            id="closeSidebarBtn"
            aria-label="Bağla"
        >

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>


    <!-- CHAT -->

    <div class="sidebar-action-area">

        <a
            href="/chat"
            class="new-chat-btn"
        >

            <i class="fa-regular fa-comments"></i>

            <span data-lang="sidebar_chat_btn">
                Çata Keçid Et
            </span>

        </a>

    </div>


    <!-- MENU -->

    <div class="sidebar-content">

        <div class="sidebar-section-title">
            Naviqasiya
        </div>


        <a
            href="/chat"
            class="sidebar-link"
        >

            <i class="fa-solid fa-house"></i>

            <span>
                Ana səhifə
            </span>

        </a>


        <a
            href="/help"
            class="sidebar-link active"
        >

            <i class="fa-solid fa-circle-question"></i>

            <span>
                Kömək
            </span>

        </a>


        <a
            href="/gizlilik"
            class="sidebar-link"
        >

            <i class="fa-solid fa-shield-halved"></i>

            <span>
                Gizlilik siyasəti
            </span>

        </a>


        <a
            href="/adapro"
            class="sidebar-link"
        >

            <i class="fa-solid fa-bolt"></i>

            <span>
                ADA Pro
            </span>

        </a>

    </div>


    <!-- FOOTER -->

    <div class="sidebar-footer">


        <!-- SETTINGS -->

        <div class="settings-dropdown-wrapper">

            <button
                class="settings-toggle-btn"
                id="settingsToggleBtn"
            >

                <i class="fa-solid fa-gear"></i>

                <span>
                    Parametrlər
                </span>

                <i class="fa-solid fa-chevron-up arrow"></i>

            </button>


            <div
                class="settings-menu"
                id="settingsMenu"
            >


                <!-- THEME -->

                <button
                    class="settings-item"
                    id="themeToggleItem"
                >

                    <i class="fa-solid fa-moon"></i>

                    <span>
                        Qaranlıq / Açıq Mod
                    </span>

                </button>


                <!-- HELP -->

                <a
                    href="/help"
                    class="settings-item"
                >

                    <i class="fa-solid fa-circle-question"></i>

                    <span>
                        Kömək
                    </span>

                </a>


                <!-- PRIVACY -->

                <a
                    href="/gizlilik"
                    class="settings-item"
                >

                    <i class="fa-solid fa-shield-halved"></i>

                    <span>
                        Gizlilik
                    </span>

                </a>

            </div>

        </div>


        <!-- USER -->

        <% if (locals.user) { %>

            <div class="user-profile">

                <div class="user-avatar">

                    <% if (user.picture || user.profile_picture) { %>

                        <img
                            src="<%= user.picture || user.profile_picture %>"
                            alt="Profil"
                        >

                    <% } else { %>

                        <i class="fa-solid fa-user"></i>

                    <% } %>

                </div>


                <div class="user-info">

                    <span class="user-name">

                        <%= user.name || user.fullname %>

                    </span>


