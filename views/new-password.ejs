
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Yeni şifrə təyin et | ADA AI</title>

    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- FontAwesome Icons -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/ada-logo.jpeg">

    <!-- Language -->
    <script src="/js/language.js"></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        html {
            background-color: #0e141f;
            height: 100%;
            overflow-x: hidden;
        }

        body {
            width: 100%;
            min-height: 100vh;
            min-height: 100dvh;

            background:
                radial-gradient(
                    circle at 85% 10%,
                    rgba(34, 211, 238, 0.13),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 50% 80%,
                    rgba(109, 93, 252, 0.18),
                    transparent 50%
                ),
                linear-gradient(
                    135deg,
                    #121928,
                    #0e141f
                );

            background-attachment: fixed;
            background-size: cover;
            background-color: #0e141f;

            display: flex;
            justify-content: center;
            align-items: center;

            overflow-x: hidden;

            color: #f8fafc;

            padding: 16px;

            padding-top: max(
                16px,
                env(safe-area-inset-top)
            );

            padding-bottom: max(
                16px,
                env(safe-area-inset-bottom)
            );
        }

        /* =========================================
           PAGE WRAPPER
        ========================================= */

        .page-wrapper {
            width: 100%;
            max-width: 1200px;

            display: flex;
            flex-direction: column;
            align-items: center;

            gap: 22px;
        }

        /* =========================================
           TOP / BOTTOM 728x90 AD
        ========================================= */

        .top-ad,
        .bottom-ad {
            width: 728px;
            max-width: 100%;

            min-height: 90px;

            display: flex;
            justify-content: center;
            align-items: center;

            overflow: hidden;

            position: relative;
            z-index: 2;
        }

        /* =========================================
           MAIN LAYOUT
        ========================================= */

        .reset-layout {
            width: 100%;

            display: grid;

            grid-template-columns:
                300px
                minmax(360px, 420px)
                300px;

            justify-content: center;

            align-items: center;

            gap: 25px;
        }

        /* =========================================
           SIDE ADS 300x250
        ========================================= */

        .side-ad {
            width: 300px;
            height: 250px;

            display: flex;
            justify-content: center;
            align-items: center;

            overflow: hidden;

            position: relative;
            z-index: 2;
        }

        /* =========================================
           CARD
        ========================================= */

        .card {
            background: rgba(255, 255, 255, 0.05);

            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);

            border: 1px solid rgba(255, 255, 255, 0.1);

            border-radius: 20px;

            padding: 40px 30px;

            width: 100%;
            max-width: 420px;

            box-shadow:
                0 8px 32px 0 rgba(0, 0, 0, 0.37);

            text-align: center;

            z-index: 10;
        }

        /* =========================================
           LOGO
        ========================================= */

        .logo-container {
            width: 64px;
            height: 64px;

            background: rgba(255, 255, 255, 0.08);

            border-radius: 16px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin: 0 auto 20px auto;

            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .logo-container i {
            font-size: 26px;
            color: #6366f1;
        }

        /* =========================================
           TITLE
        ========================================= */

        h1 {
            font-size: 22px;
            font-weight: 700;

            margin-bottom: 8px;

            color: #fff;
        }

        p.subtitle {
            font-size: 13.5px;

            color: #94a3b8;

            margin-bottom: 24px;

            line-height: 1.5;
        }

        /* =========================================
           FORM
        ========================================= */

        .form-group {
            text-align: left;

            margin-bottom: 20px;
        }

        .form-group label {
            display: block;

            font-size: 13.5px;

            font-weight: 500;

            color: #cbd5e1;

            margin-bottom: 8px;
        }

        .input-wrapper {
            position: relative;

            display: flex;
            align-items: center;
        }

        .input-wrapper i {
            position: absolute;

            left: 14px;

            color: #64748b;

            z-index: 2;
        }

        .input-wrapper input {
            width: 100%;

            background: rgba(255, 255, 255, 0.07);

            border: 1px solid rgba(255, 255, 255, 0.12);

            border-radius: 12px;

            padding: 12px 14px 12px 42px;

            color: #fff;

            font-size: 14px;

            outline: none;

            transition: all 0.3s ease;
        }

        .input-wrapper input::placeholder {
            color: #64748b;
        }

        .input-wrapper input:focus {
            border-color: #6366f1;

            box-shadow:
                0 0 0 3px rgba(99, 102, 241, 0.2);
        }

        /* =========================================
           SUBMIT BUTTON
        ========================================= */

        button[type="submit"] {
            width: 100%;

            background:
                linear-gradient(
                    135deg,
                    #6366f1 0%,
                    #4f46e5 100%
                );

            color: #fff;

            border: none;

            border-radius: 12px;

            padding: 12px;

            font-size: 14.5px;

            font-weight: 600;

            cursor: pointer;

            transition: all 0.3s ease;

            margin-top: 10px;
        }

        button[type="submit"]:hover {
            background:
                linear-gradient(
                    135deg,
                    #4f46e5 0%,
                    #4338ca 100%
                );

            transform: translateY(-1px);

            box-shadow:
                0 4px 12px rgba(99, 102, 241, 0.4);
        }

        button[type="submit"]:active {
            transform: translateY(0);
        }

        /* =========================================
           FOOTER LINK
        ========================================= */

        .footer-link {
            margin-top: 24px;

            font-size: 13.5px;

            color: #94a3b8;
        }

        .footer-link a {
            color: #818cf8;

            text-decoration: none;

            font-weight: 500;
        }

        .footer-link a:hover {
            text-decoration: underline;
        }

        /* =========================================
           TABLET
        ========================================= */

        @media (max-width: 1100px) {

            .reset-layout {
                grid-template-columns: 1fr;
            }

            .side-ad {
                display: none;
            }

            .card {
                max-width: 420px;
            }
        }

        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 768px) {

            body {
                padding-left: 12px;
                padding-right: 12px;
            }

            .page-wrapper {
                gap: 16px;
            }

            .top-ad,
            .bottom-ad {
                display: none;
            }

            .card {
                padding: 32px 22px;

                border-radius: 18px;
            }

            h1 {
                font-size: 20px;
            }

            p.subtitle {
                font-size: 13px;
            }
        }

        /* =========================================
           SMALL MOBILE
        ========================================= */

        @media (max-width: 420px) {

            body {
                padding-left: 10px;
                padding-right: 10px;
            }

            .card {
                padding: 28px 18px;
            }

            .logo-container {
                width: 58px;
                height: 58px;
            }

            .logo-container i {
                font-size: 24px;
            }

            h1 {
                font-size: 19px;
            }

            .footer-link {
                font-size: 12.5px;
            }
        }
    </style>
</head>

<body>

<div class="page-wrapper">

    <!-- =========================================
         TOP 728x90 AD
    ========================================= -->

    <div class="top-ad">

        <script type="text/javascript">
            atOptions = {
                'key': 'b4aa0de4c99e09f953836c06fc79b41b',
                'format': 'iframe',
                'height': 90,
                'width': 728,
                'params': {}
            };
        </script>

        <script
            type="text/javascript"
            src="https://www.highrevenueformat.com/b4aa0de4c99e09f953836c06fc79b41b/invoke.js">
        </script>

    </div>


    <!-- =========================================
         MAIN CONTENT
    ========================================= -->

    <div class="reset-layout">

        <!-- LEFT 300x250 AD -->

        <div class="side-ad">

            <script type="text/javascript">
                atOptions = {
                    'key': '32c0d5d001f16a4abbab1b16495876d7',
                    'format': 'iframe',
                    'height': 250,
                    'width': 300,
                    'params': {}
                };
            </script>

            <script
                type="text/javascript"
                src="https://www.highrevenueformat.com/32c0d5d001f16a4abbab1b16495876d7/invoke.js">
            </script>

        </div>


        <!-- =========================================
             RESET PASSWORD CARD
        ========================================= -->

        <div class="card">

            <div class="logo-container">
                <i class="fa-solid fa-key"></i>
            </div>

            <h1>
                Yeni şifrə təyin et
            </h1>

            <p class="subtitle">
                Zəhmət olmasa hesabınız üçün yeni və güclü bir şifrə yazın.
            </p>


            <form action="/new-password" method="POST">

                <!-- URL-dən gələn email -->
                <input
                    type="hidden"
                    name="email"
                    value="<%= email %>"
                >


                <div class="form-group">

                    <label for="newPassword">
                        Yeni şifrə
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-lock"></i>

                        <input
                            type="password"
                            id="newPassword"
                            name="newPassword"
                            placeholder="Yeni şifrənizi daxil edin"
                            required
                            minlength="6"
                            autocomplete="new-password"
                        >

                    </div>

                </div>


                <button type="submit">
                    Şifrəni yenilə
                </button>

            </form>


            <div class="footer-link">

                Şifrənizi xatırladınız?

                <a href="/login">
                    Giriş səhifəsinə qayıt
                </a>

            </div>

        </div>


        <!-- RIGHT 300x250 AD -->

        <div class="side-ad">

            <script type="text/javascript">
                atOptions = {
                    'key': '32c0d5d001f16a4abbab1b16495876d7',
                    'format': 'iframe',
                    'height': 250,
                    'width': 300,
                    'params': {}
                };
            </script>

            <script
                type="text/javascript"
                src="https://www.highrevenueformat.com/32c0d5d001f16a4abbab1b16495876d7/invoke.js">
            </script>

        </div>

    </div>


    <!-- =========================================
         BOTTOM 728x90 AD
    ========================================= -->

    <div class="bottom-ad">

        <script type="text/javascript">
            atOptions = {
                'key': 'b4aa0de4c99e09f953836c06fc79b41b',
                'format': 'iframe',
                'height': 90,
                'width': 728,
                'params': {}
            };
        </script>

        <script
            type="text/javascript"
            src="https://www.highrevenueformat.com/b4aa0de4c99e09f953836c06fc79b41b/invoke.js">
        </script>

    </div>

</div>


