            target="_blank"
            class="modal-wiki-btn"
            id="modalWikiBtn">

            <i class="fa-brands fa-wikipedia-w"></i>

            <span data-lang="wiki_btn_text">
                Vikipediya Məqaləsinə Keç
            </span>

        </a>

    </div>

</div>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

    /* =========================================================
       SIDEBAR
    ========================================================= */

    function toggleSidebar() {

        const sidebar =
            document.getElementById("sidebar");

        const overlay =
            document.getElementById("sidebarOverlay");

        const button =
            document.getElementById("menuToggleBtn");

        if (!sidebar || !overlay) return;

        sidebar.classList.toggle("open");

        overlay.classList.toggle("active");

        const isOpen =
            sidebar.classList.contains("open");

        if (button) {

            button.innerHTML = isOpen
                ? '<i class="fa-solid fa-xmark"></i>'
                : '<i class="fa-solid fa-bars"></i>';

        }

    }


    function closeSidebar() {

        const sidebar =
            document.getElementById("sidebar");

        const overlay =
            document.getElementById("sidebarOverlay");

        const button =
            document.getElementById("menuToggleBtn");

        if (sidebar)
            sidebar.classList.remove("open");

        if (overlay)
            overlay.classList.remove("active");

        if (button)
            button.innerHTML =
                '<i class="fa-solid fa-bars"></i>';

    }


    /* =========================================================
       FEATURE MODAL
    ========================================================= */

    const featureData = {

        logic: {

            icon: "fa-solid fa-brain",

            title: "Dərin Məntiq Modeli",

            description:
                "ADA Pro mürəkkəb akademik sualların, riyazi məsələlərin, məntiq tapşırıqlarının və proqramlaşdırma problemlərinin daha ətraflı izahını almağa kömək edir.",

            wiki:
                "https://en.wikipedia.org/wiki/Artificial_intelligence"

        },

        pdf: {

            icon: "fa-solid fa-file-pdf",

            title: "PDF & Sənəd Analizi",

            description:
                "Dərs materialları və sənədlərlə işləyərək vacib məlumatları strukturlaşdırmaq, xülasə hazırlamaq və öyrənmə prosesini sürətləndirmək üçün istifadə edə bilərsiniz.",

            wiki:
                "https://en.wikipedia.org/wiki/PDF"

        },

        limits: {

            icon: "fa-solid fa-infinity",

            title: "Yüksək Limitlər",

            description:
                "ADA Pro planı daha geniş istifadə imkanları təqdim etmək üçün nəzərdə tutulur. Faktiki limitlər seçilmiş plan və xidmət şərtlərinə uyğun tətbiq olunur.",

            wiki:
                "https://en.wikipedia.org/wiki/Rate_limiting"

        },

        code: {

            icon: "fa-solid fa-code",

            title: "Kod Debugger",

            description:
                "JavaScript, HTML, CSS, Node.js və digər proqramlaşdırma texnologiyalarında kod problemlərini analiz etmək və mümkün həll yollarını araşdırmaq üçün AI dəstəyindən istifadə edə bilərsiniz.",

            wiki:
                "https://en.wikipedia.org/wiki/Debugging"

        }

    };


    function openModal(type) {

        const data =
            featureData[type];

        if (!data) return;


        const modal =
            document.getElementById("infoModal");

        const icon =
            document.getElementById("modalIcon");

        const title =
            document.getElementById("modalTitle");

        const desc =
            document.getElementById("modalDesc");

        const wiki =
            document.getElementById("modalWikiBtn");


        icon.innerHTML =
            `<i class="${data.icon}"></i>`;

        title.textContent =
            data.title;

        desc.textContent =
            data.description;

        wiki.href =
            data.wiki;


        modal.classList.add("active");

        document.body.style.overflow =
            "hidden";

    }


    function closeModal() {

        const modal =
            document.getElementById("infoModal");

        if (!modal) return;

        modal.classList.remove("active");

        document.body.style.overflow =
            "";

    }


    function closeModalOutside(event) {

        if (
            event.target.id === "infoModal"
        ) {

            closeModal();

        }

    }


    /* ESC */

    document.addEventListener(
        "keydown",
        function(event) {

            if (event.key === "Escape") {

                closeModal();

                closeSidebar();

            }

        }
    );


    /* =========================================================
       UPGRADE
    ========================================================= */

    function startUpgrade() {

        /*
         * Burada gələcəkdə ödəniş sistemi qoşa bilərsən.
         *
         * Məsələn:
         *
         * window.location.href = "/pro/checkout";
         *
         * və ya Stripe / başqa ödəniş sistemi.
         */

        alert(
            "ADA Pro abunəliyi üçün ödəniş sistemi hazırlanır."
        );

    }


    /* =========================================================
       TRANSLATION
    ========================================================= */

    function applyAutoTranslation(lang) {

        const currentLang =
            lang ||
            localStorage.getItem("userLanguage") ||
            "az";


        document
            .querySelectorAll("[data-lang]")
            .forEach(function(el) {

                const key =
                    el.getAttribute("data-lang");


                if (
                    typeof dictionary !== "undefined" &&
                    dictionary[key]
                ) {

                    if (
                        dictionary[key][currentLang]
                    ) {

                        el.textContent =
                            dictionary[key][currentLang];

                    }

                    else if (
                        dictionary[key]["az"]
                    ) {

                        el.textContent =
                            dictionary[key]["az"];

                    }

                }

                else if (
                    typeof translations !== "undefined" &&
                    translations[currentLang] &&
                    translations[currentLang][key]
                ) {

                    el.textContent =
                        translations[currentLang][key];

                }

            });

    }


    function setLanguage(lang) {

        localStorage.setItem(
            "userLanguage",
            lang
        );

        applyAutoTranslation(lang);

    }


    /* =========================================================
       INITIALIZATION
    ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            const savedLang =
                localStorage.getItem(
                    "userLanguage"
                ) || "az";

            applyAutoTranslation(
                savedLang
            );


            /* Mobile sidebar link click */

            document
                .querySelectorAll(".sidebar-link")
                .forEach(function(link) {

                    link.addEventListener(
                        "click",
                        function() {

                            if (
                                window.innerWidth <= 768
                            ) {

                                closeSidebar();

                            }

                        }
                    );

                });

        }
    );


    /* =========================================================
       LANGUAGE STORAGE SYNC
    ========================================================= */

    window.addEventListener(
        "storage",
        function(event) {

            if (
                [
                    "userLanguage",
                    "app_lang",
                    "lang",
                    "language",
                    "site_language"
                ].includes(event.key)
            ) {

                const newLang =
                    event.newValue || "az";

                applyAutoTranslation(
                    newLang
                );

            }

        }
    );

</script>

</body>
</html>

