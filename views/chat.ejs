    .settings-dropdown-container {
        position: relative;
        width: 100%;
    }

    .settings-toggle-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        background: transparent;
        border: none;
        color: var(--text-muted);
        padding: 10px 12px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.2s, color 0.2s;
    }

    .settings-toggle-btn:hover {
        background: var(--settings-item-hover);
        color: var(--text-main);
    }

    /* Açılır menyu paneli */
    .settings-menu {
        position: absolute;
        bottom: 100%;
        left: 0;
        width: 240px;
        background: var(--settings-menu-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        display: none;
        flex-direction: column;
        padding: 8px 0;
        margin-bottom: 8px;
        z-index: 1000;
    }

    .settings-menu.active {
        display: flex;
    }

    .settings-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 13px;
        transition: background 0.2s, color 0.2s;
        cursor: pointer;
        background: transparent;
        border: none;
        width: 100%;
        text-align: left;
    }

    .settings-item:hover {
        background: var(--settings-item-hover);
        color: var(--text-main);
    }

    .settings-item i {
        width: 16px;
        text-align: center;
        color: var(--text-muted);
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        overflow: hidden;
        flex: 1;
    }

    .user-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid var(--border-color);
