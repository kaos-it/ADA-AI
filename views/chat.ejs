        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        overflow: hidden;
    }

    .user-avatar img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .user-info {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .user-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-main);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-email {
        font-size: 11px;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        width: 32px;
        height: 32px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        text-decoration: none;
        font-size: 15px;
    }

    .action-btn:hover {
        background: var(--settings-item-hover);
        color: var(--text-main);
    }

    .register-link-btn {
        width: 100%;
        background: rgba(99, 102, 241, 0.15);
        border: 1px solid rgba(99, 102, 241, 0.3);
        padding: 10px;
        border-radius: 10px;
        color: #818cf8;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        transition: background 0.2s;
    }

    .register-link-btn:hover {
        background: rgba(99, 102, 241, 0.25);
        color: var(--text-main);
    }

    /* Chat Main */
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: transparent;
        position: relative;
        height: 100%;
        width: 100%;
        overflow: hidden;
    }

    .chat-header {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--chat-header-bg);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .menu-toggle-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 20px;
        cursor: pointer;
        display: none;
        padding: 4px;
    }

    .chat-header h3 {
        font-size: 16px;
        font-weight: 600;
        color: var(--text-main);
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        scroll-behavior: smooth;
    }

    .message {
        display: flex;
        gap: 12px;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
    }

    .message.user {
        flex-direction: row-reverse;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 14px;
        overflow: hidden;
    }

    .message.user .avatar {
        background: #334155;
        color: #cbd5e1;
    }

    .message-content {
        background: var(--message-ai-bg);
        border: 1px solid var(--border-color);
        padding: 12px 16px;
        border-radius: 14px;
        font-size: 14px;
        line-height: 1.5;
        color: var(--text-main);
        max-width: calc(100% - 50px);
        word-break: break-word;
    }

    .message.user .message-content {
        background: var(--message-user-bg);
        border-color: rgba(99, 102, 241, 0.2);
    }

    /* Input Container & Buttons */
    .chat-input-container {
        padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)) 16px;
        background: linear-gradient(to top, var(--bg-html-2) 70%, transparent 100%);
    }

    .premium-select-wrapper {
        max-width: 900px;
        margin: 0 auto 8px auto;
        display: flex;
        justify-content: flex-start;
        gap: 8px;
        flex-wrap: wrap;
    }

    .premium-lesson-btn, .ada-pro-btn {
        padding: 8px 14px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .premium-lesson-btn {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(168, 85, 247, 0.2));
        border: 1px solid rgba(99, 102, 241, 0.4);
        color: #c7d2fe;
    }

    .ada-pro-btn {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(239, 68, 68, 0.2));
        border: 1px solid rgba(245, 158, 11, 0.4);
        color: #fde68a;
    }

    .chat-input-wrapper {
        max-width: 900px;
        margin: 0 auto;
        background: var(--input-wrapper-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 8px 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .chat-input-wrapper textarea {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: var(--text-main);
        font-size: 16px;
        resize: none;
        max-height: 120px;
        min-height: 24px;
        line-height: 1.4;
    }

    .input-action-btn, .send-btn {
        cursor: pointer;
        background: transparent;
        border: none;
        color: var(--text-muted);
    }

    .send-btn {
        background: #6366f1;
        color: white;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .disclaimer {
        text-align: center;
        font-size: 8px;
        color: var(--text-muted);
        padding: 6px 12px;
        margin-top: 6px;
    }

    @media (max-width: 768px) {
        .sidebar {
            position: fixed;
            top: 0;
            left: -320px;
            height: 100%;
        }
        .sidebar.open {
            left: 0;
        }
        .close-sidebar-btn, .menu-toggle-btn {
            display: block;
        }
    }

    /* Çat və input hissəsinin açıq modda fon rəngləri */
    body.light-mode .chat-main,
    body.light-mode .chat-messages,
    body.light-mode .chat-input-container {
        background: #f8fafc !important;
    }

    /* Input sahəsinin altındakı gradient keçidini açıq moda uyğunlaşdırırıq */
    body.light-mode .chat-input-container {
        background: linear-gradient(to top, #f8fafc 70%, transparent 100%) !important;
    }

    /* Dil konteyneri */
.language-dropdown {
    position: relative;
    width: 100%;
}

/* Dil düyməsi daxilində ox işarəsinin sağa sıxılması */
.language-btn {
    display: flex;
    align-items: center;
    width: 100%;
    cursor: pointer;
}

.language-btn .arrow-icon {
    margin-left: auto;
    transition: transform 0.3s ease;
}

/* Menyunu kliklədikdə ox işarəsinin dönməsi */
.language-dropdown.active .arrow-icon {
    transform: rotate(180deg);
}

/* Üst-üstə açılan menyu */
.language-menu {
    display: none; /* Başlanğıcda gizli olur */
    flex-direction: column;
    gap: 4px;
    padding: 6px 0 6px 30px; /* İçəri sürüşmə (indentation) */
    background: transparent;
}

/* Menyunu aktiv edəndə görünür */
.language-dropdown.active .language-menu {
    display: flex;
}

/* Hər bir dil elementi */
.lang-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border: none;
    background: transparent;
    color: inherit;
    font-size: 14px;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.2s ease;
    text-align: left;
    width: 100%;
}

.lang-option:hover {
    background-color: rgba(255, 255, 255, 0.1); /* Və ya qaranlıq moda uyğun rəng */
}
/* AI cavab düymələri */
.ai-message-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--border-color);
}

.ai-message-action {
    border: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
}

.ai-message-action:hover {
    background: rgba(99, 102, 241, 0.15);
    color: var(--text-main);
    border-color: rgba(99, 102, 241, 0.35);
}

.ai-message-action.speaking {
    color: #818cf8;
    border-color: #818cf8;
    background: rgba(99, 102, 241, 0.12);
}

.ai-message-action.copied {
    color: #22c55e;
    border-color: rgba(34, 197, 94, 0.4);
    background: rgba(34, 197, 94, 0.08);
}

.ai-message-action i {
    font-size: 12px;
}

@media (max-width: 768px) {
    .ai-message-action {
        padding: 7px 10px;
        font-size: 11px;
    }
}

/* =========================================================
   AI MESSAGE ACTION BUTTONS
   ========================================================= */

.ai-message-actions {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
    padding-top: 9px;
    border-top: 1px solid var(--border-color);
}

.ai-message-action {
    border: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    border-radius: 9px;
    padding: 7px 11px;
    font-size: 12px;
    cursor: pointer;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
}

.ai-message-action:hover {
    background: rgba(99, 102, 241, 0.14);
    color: var(--text-main);
    border-color: rgba(99, 102, 241, 0.4);
}

.ai-message-action:active {
    transform: scale(0.95);
}

.ai-message-action.speaking {
    color: #818cf8;
    border-color: #818cf8;
    background: rgba(99, 102, 241, 0.14);
}

.ai-message-action.copied {
    color: #22c55e;
    border-color: rgba(34, 197, 94, 0.45);
    background: rgba(34, 197, 94, 0.09);
}

.ai-message-action i {
    font-size: 12px;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 768px) {

    .ai-message-actions {
        margin-top: 10px;
        padding-top: 8px;
        gap: 6px;
    }

    .ai-message-action {
        padding: 8px 10px;
        font-size: 11px;
        border-radius: 8px;
    }

    .ai-message-action i {
        font-size: 11px;
    }

}
</style>


